# -------------------------------------------------------
# App
# -------------------------------------------------------
NODE_ENV=production
PORT=3333
HOST=0.0.0.0
APP_NAME=HisReport
# สร้าง key ด้วย: node ace generate:key
APP_KEY=
LOG_LEVEL=info
SESSION_DRIVER=cookie
TZ=Asia/Bangkok

# -------------------------------------------------------
# App Database (MySQL หลักของระบบ)
# รัน schema: database/schema.sql ก่อนเปิดระบบ
# -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=hisreport

# -------------------------------------------------------
# HIS Database (อ่านอย่างเดียว — bootstrap เท่านั้น)
# ค่าจริงเก็บใน his_settings table หลังตั้งค่าในระบบ
# -------------------------------------------------------
HIS_DB_HOST=127.0.0.1
HIS_DB_PORT=3306
HIS_DB_USER=
HIS_DB_PASSWORD=
HIS_DB_DATABASE=

# -------------------------------------------------------
# โมดูลขอข้อมูล/รายงาน
# -------------------------------------------------------
# URL ของระบบ ใช้ในลิงก์/ปุ่มในข้อความ LINE
APP_URL=
# LINE ผ่าน MOPH Notify (หมอพร้อม) — ตั้งจากหน้า ตั้งค่าระบบ > การแจ้งเตือน ได้ (ค่าในหน้าเว็บทับค่านี้)
MOPH_NOTIFY_API_URL=https://morpromt2f.moph.go.th/api/notify/send
MOPH_NOTIFY_CLIENT_KEY=
MOPH_NOTIFY_SECRET_KEY=
# จำนวนวันที่เก็บไฟล์ของคำขอข้อมูลรายบุคคลหลังปิดงาน (ค่าเริ่มต้น 30)
# ลบด้วย: node ace requests:purge-files  (ตั้ง cron / Task Scheduler วันละครั้ง)
REQUEST_FILE_RETENTION_DAYS=30
