{{--
  Sidebar partial — port of includes/components/admin_sidebar.php
  Expects locals:
    - isAdmin (boolean)
    - fullname (string)
    - department (string)
    - currentPage (string)  // e.g. 'dashboard', 'mainreport'
--}}
@let(sbIsAdmin = (typeof isAdmin !== 'undefined' && isAdmin) ? true : false)
@let(sbFullname = (typeof fullname !== 'undefined' && fullname) ? fullname : (sbIsAdmin ? 'ผู้ดูแลระบบ' : 'ผู้ใช้'))
@let(sbDepartment = (typeof department !== 'undefined' && department) ? department : '—')
@let(sbCurrentPage = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : '')
@let(sbUserInitial = sbFullname.substring(0, 1).toUpperCase())
@let(sbRoleLabel = sbIsAdmin ? 'ผู้ดูแลระบบ' : 'ผู้ใช้งาน')

<aside class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r border-gray-200 flex flex-col" aria-label="เมนูหลัก">
  <div class="flex items-center gap-3 px-5 py-5 border-b border-gray-200">
    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
      <i class="fas fa-heart-pulse text-xl"></i>
    </div>
    <div class="leading-tight">
      <div class="font-semibold text-gray-800">HisReport</div>
      <div class="text-xs text-gray-500">ระบบรายงานสถิติ</div>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto py-3 px-3 space-y-1 text-sm">
    @if(sbIsAdmin)
      <div class="px-2 pt-2 pb-1 text-xs uppercase text-gray-400">ภาพรวม</div>
      <a href="/admin/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'dashboard' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-gauge-high w-4"></i><span>แดชบอร์ดผู้ดูแล</span>
      </a>
      <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'index_dashboard' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-chart-pie w-4"></i><span>แดชบอร์ดรายงาน</span>
      </a>

      <div class="px-2 pt-3 pb-1 text-xs uppercase text-gray-400">รายงาน</div>
      <a href="/reports" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'mainreport' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-file-lines w-4"></i><span>รายงานทั้งหมด</span>
      </a>

      <div class="px-2 pt-3 pb-1 text-xs uppercase text-gray-400">การจัดการระบบ</div>
      <a href="/admin/report-settings" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'report-settings' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-sliders w-4"></i><span>ตั้งค่ารายงาน</span>
      </a>
      <a href="/admin/dashboard-settings" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'dashboard-settings' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-chart-line w-4"></i><span>ตั้งค่าแดชบอร์ด</span>
      </a>
      <a href="/admin/users" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 text-gray-700">
        <i class="fas fa-users-gear w-4"></i><span>จัดการผู้ใช้</span>
      </a>
      <a href="/admin/his-settings" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'his-settings' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-database w-4"></i><span>ตั้งค่า HIS</span>
      </a>
    @else
      <div class="px-2 pt-2 pb-1 text-xs uppercase text-gray-400">ภาพรวม</div>
      <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 {{ sbCurrentPage === 'home' ? 'bg-primary/10 text-primary font-medium' : 'text-gray-700' }}">
        <i class="fas fa-house w-4"></i><span>หน้าหลัก</span>
      </a>
      <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 text-gray-700">
        <i class="fas fa-chart-pie w-4"></i><span>แดชบอร์ด</span>
      </a>

      <div class="px-2 pt-3 pb-1 text-xs uppercase text-gray-400">รายงาน</div>
      <a href="/reports" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 text-gray-700">
        <i class="fas fa-file-lines w-4"></i><span>รายงานทั้งหมด</span>
      </a>
    @end
  </nav>

  <div class="border-t border-gray-200 p-3">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-semibold">
        {{ sbUserInitial }}
      </div>
      <div class="leading-tight">
        <div class="text-sm font-medium text-gray-800">{{ sbFullname }}</div>
        <div class="text-xs text-gray-500">
          {{ sbDepartment }}
          <span class="ml-1 inline-block px-1.5 py-0.5 rounded text-[10px] {{ sbIsAdmin ? 'bg-warning/20 text-warning' : 'bg-primary/20 text-primary' }}">
            {{ sbRoleLabel }}
          </span>
        </div>
      </div>
    </div>
    <a href="/logout" class="block w-full text-center text-sm py-1.5 rounded-md border border-danger text-danger hover:bg-danger hover:text-white transition">
      <i class="fas fa-arrow-right-from-bracket"></i> ออกจากระบบ
    </a>
  </div>
</aside>
