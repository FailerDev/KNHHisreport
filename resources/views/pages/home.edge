@let(homeIsAdmin = user ? user.userLevel === 'admin' : false)
@component('layouts/app', {
  title: 'HisReport — ระบบรายงาน HIS',
  showSidebar: !!user,
  isAdmin: homeIsAdmin,
  fullname: user ? (user.fullname || user.username) : '',
  department: user ? user.department : '',
  currentPage: 'home',
})
  @slot('main')
    @if(user)
      @include('partials/launcher')
    @else
      <div class="max-w-6xl mx-auto">
        {{-- Guest top bar --}}
        <div class="flex items-center justify-between mb-10">
          <a class="hic-brand" href="/">
            <span class="hic-logo"><i class="fas fa-heart-pulse"></i></span>
            <span class="hic-brand-text"><b>HisReport</b><span>ระบบรายงานข้อมูล HIS</span></span>
          </a>
          <div class="flex items-center gap-2">
            <button class="hic-iconbtn" type="button" data-theme-toggle aria-label="สลับโหมดสว่าง/มืด"><i class="fas fa-moon" data-theme-icon></i></button>
            <a href="/login" class="hic-btn hic-btn-secondary"><i class="fas fa-right-to-bracket"></i>เข้าสู่ระบบ</a>
          </div>
        </div>

        {{-- Hero --}}
        <section class="hic-banner hic-rise" style="padding:48px 40px">
          <div class="hic-banner-text">
            <span class="hic-banner-eyebrow"><i class="fas fa-hospital"></i>Hospital Information System</span>
            <h1 class="hic-greeting" style="font-size:38px;line-height:50px">รายงานข้อมูล HIS<br />ครบ จบ ในที่เดียว</h1>
            <p class="hic-banner-msg">สร้าง เรียกใช้ และส่งออกรายงานจากฐานข้อมูล HIS พร้อมแดชบอร์ดสรุปตัวเลขสำคัญแบบเรียลไทม์</p>
            <div class="hic-banner-actions">
              <a href="/login" class="hic-btn hic-btn-white hic-btn-lg"><i class="fas fa-right-to-bracket"></i>เข้าสู่ระบบ</a>
              <a href="/register" class="hic-btn hic-btn-glass hic-btn-lg"><i class="fas fa-user-plus"></i>สมัครสมาชิก</a>
            </div>
          </div>
          <div class="hic-stats">
            <div class="hic-stat"><span class="hic-stat-icon"><i class="fas fa-bolt"></i></span><span class="hic-stat-body"><b>Real-time</b><span>สถิติจาก HIS</span></span></div>
            <div class="hic-stat"><span class="hic-stat-icon"><i class="fas fa-file-excel"></i></span><span class="hic-stat-body"><b>.xlsx</b><span>ส่งออกได้ทันที</span></span></div>
          </div>
          <span class="hic-banner-mark" aria-hidden="true"><i class="fas fa-heart-pulse"></i></span>
        </section>

        {{-- Features --}}
        <div class="hic-grid mt-8" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
          <div class="hic-card hic-tone-blue" style="--i:1;cursor:default">
            <div class="hic-card-top"><span class="hic-tile"><i class="fas fa-chart-line"></i></span></div>
            <div class="hic-card-text">
              <span class="hic-card-label">แดชบอร์ดสถิติ</span>
              <span class="hic-card-desc">สรุปตัวเลขสำคัญแบบเรียลไทม์ พร้อมกราฟ Pie / Bar ที่ปรับแต่งได้</span>
            </div>
            <span class="hic-watermark"><i class="fas fa-chart-line"></i></span>
          </div>
          <div class="hic-card hic-tone-green" style="--i:2;cursor:default">
            <div class="hic-card-top"><span class="hic-tile"><i class="fas fa-file-excel"></i></span></div>
            <div class="hic-card-text">
              <span class="hic-card-label">ส่งออก Excel</span>
              <span class="hic-card-desc">ดาวน์โหลดผลรายงานเป็น .xlsx ได้ทุกรายงาน รองรับข้อมูลปริมาณมาก</span>
            </div>
            <span class="hic-watermark"><i class="fas fa-file-excel"></i></span>
          </div>
          <div class="hic-card hic-tone-violet" style="--i:3;cursor:default">
            <div class="hic-card-top"><span class="hic-tile"><i class="fas fa-sliders"></i></span></div>
            <div class="hic-card-text">
              <span class="hic-card-label">จัดการรายงานเอง</span>
              <span class="hic-card-desc">ผู้ดูแลระบบสร้าง/แก้ไขรายงานและพารามิเตอร์ได้จากหน้าเว็บ ไม่ต้องแก้โค้ด</span>
            </div>
            <span class="hic-watermark"><i class="fas fa-sliders"></i></span>
          </div>
          <div class="hic-card hic-tone-teal" style="--i:4;cursor:default">
            <div class="hic-card-top"><span class="hic-tile"><i class="fas fa-shield-halved"></i></span></div>
            <div class="hic-card-text">
              <span class="hic-card-label">ปลอดภัย</span>
              <span class="hic-card-desc">อ่านข้อมูล HIS แบบ read-only พร้อมบันทึก audit log ทุกการเปลี่ยนแปลง</span>
            </div>
            <span class="hic-watermark"><i class="fas fa-shield-halved"></i></span>
          </div>
        </div>
      </div>
    @end
  @end
@end
