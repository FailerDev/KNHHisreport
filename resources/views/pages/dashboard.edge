@component('layouts/app', {
  title: isAdmin ? 'แดชบอร์ดผู้ดูแล · HisReport' : 'หน้าหลัก · HisReport',
  showSidebar: true,
  isAdmin: isAdmin,
  fullname: user?.fullname || user?.username,
  department: user?.department,
  currentPage: isAdmin ? 'dashboard' : 'home',
})
  @slot('main')
    <div class="max-w-5xl">
      <h1 class="text-2xl font-semibold text-gray-800 mb-2">
        @if(isAdmin)
          แดชบอร์ดผู้ดูแลระบบ
        @else
          ยินดีต้อนรับ {{ user?.fullname || user?.username }}
        @end
      </h1>
      <p class="text-sm text-gray-500 mb-6">
      </p>

      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <h2 class="text-base font-medium text-gray-700 mb-3">ข้อมูลผู้ใช้ปัจจุบัน</h2>
        <dl class="grid grid-cols-2 gap-3 text-sm">
          <dt class="text-gray-500">ชื่อผู้ใช้</dt><dd class="text-gray-800">{{ user?.username }}</dd>
          <dt class="text-gray-500">ชื่อ-นามสกุล</dt><dd class="text-gray-800">{{ user?.fullname || '—' }}</dd>
          <dt class="text-gray-500">แผนก</dt><dd class="text-gray-800">{{ user?.department || '—' }}</dd>
          <dt class="text-gray-500">สิทธิ์</dt><dd class="text-gray-800">{{ user?.userLevel }}</dd>
          <dt class="text-gray-500">เข้าใช้ครั้งล่าสุด</dt><dd class="text-gray-800">{{ user?.lastLogin?.toFormat?.('yyyy-MM-dd HH:mm') || '—' }}</dd>
        </dl>
      </div>
    </div>
  @end
@end
