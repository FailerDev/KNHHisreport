{{--
  /manual — in-app user manual. Admin chapters render only for admins.
  Section ids are linked from the topbar help button (partials/topbar), so
  keep them stable when editing.
--}}
@let(mnIsAdmin = auth.user.userLevel === 'admin')
@let(mnUserToc = [
  { id: 'start', icon: 'fa-right-to-bracket', label: 'เริ่มต้นใช้งาน' },
  { id: 'navigation', icon: 'fa-compass', label: 'หน้าหลักและเมนู' },
  { id: 'dashboard', icon: 'fa-chart-pie', label: 'แดชบอร์ด' },
  { id: 'reports', icon: 'fa-file-lines', label: 'รายงาน' },
  { id: 'requests', icon: 'fa-inbox', label: 'ขอข้อมูล/รายงาน' },
  { id: 'notifications', icon: 'fa-bell', label: 'การแจ้งเตือน' },
  { id: 'account-security', icon: 'fa-user-shield', label: 'ความปลอดภัยบัญชี (2FA)' },
  { id: 'faq', icon: 'fa-circle-question', label: 'ปัญหาที่พบบ่อย' },
])
@let(mnAdminToc = [
  { id: 'admin-settings', icon: 'fa-gear', label: 'ภาพรวมการตั้งค่า' },
  { id: 'admin-requests', icon: 'fa-list-check', label: 'จัดการคำขอข้อมูล' },
  { id: 'admin-reports', icon: 'fa-sliders', label: 'ตั้งค่ารายงาน' },
  { id: 'admin-parameters', icon: 'fa-list-ol', label: 'พารามิเตอร์รายงาน' },
  { id: 'admin-dashboard', icon: 'fa-chart-line', label: 'ตั้งค่าแดชบอร์ด' },
  { id: 'admin-users', icon: 'fa-users-gear', label: 'ผู้ใช้และสิทธิ์' },
  { id: 'admin-his', icon: 'fa-database', label: 'HIS Database' },
  { id: 'admin-notifications', icon: 'fa-bullhorn', label: 'ตั้งค่าการแจ้งเตือน' },
  { id: 'admin-security', icon: 'fa-shield-halved', label: 'ตั้งค่าความปลอดภัย' },
])

@component('layouts/app', {
  title: 'คู่มือการใช้งาน · HisReport',
  showSidebar: true,
  isAdmin: mnIsAdmin,
  fullname: auth.user.fullname || auth.user.username,
  department: auth.user.department,
  currentPage: 'manual',
})
  @slot('head')
    <style>
      .mn-layout { display: grid; gap: 24px; align-items: start; }
      @media (min-width: 1024px) { .mn-layout { grid-template-columns: 250px minmax(0, 1fr); } }
      .mn-toc { display: flex; flex-direction: column; gap: 2px; }
      @media (min-width: 1024px) {
        .mn-toc-wrap { position: sticky; top: calc(var(--header-height, 64px) + 16px); max-height: calc(100vh - var(--header-height, 64px) - 32px); overflow-y: auto; }
      }
      .mn-toc-label { padding: 12px 10px 4px; font-size: 12px; font-weight: 700; color: var(--ink-muted); }
      .mn-toc a { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 10px; font-size: 14px; color: var(--ink); text-decoration: none; }
      .mn-toc a i { width: 16px; text-align: center; color: var(--ink-muted); }
      .mn-toc a:hover { background: var(--surface-sunken); }
      .mn-toc a.is-on { background: var(--brand-soft); color: var(--brand-from); font-weight: 600; }
      .mn-toc a.is-on i { color: var(--brand-from); }
      .mn-sec { scroll-margin-top: calc(var(--header-height, 64px) + 16px); }
      .mn-body { display: flex; flex-direction: column; gap: 14px; font-size: 15px; line-height: 1.75; color: var(--ink); }
      .mn-body h3 { margin-top: 6px; font-size: 16px; font-weight: 700; color: var(--ink-strong); }
      .mn-body ul, .mn-body ol { padding-left: 22px; display: flex; flex-direction: column; gap: 4px; }
      .mn-body ul { list-style: disc; }
      .mn-body ol { list-style: decimal; }
      .mn-body b { color: var(--ink-strong); }
      .mn-body code { padding: 1px 6px; border-radius: 6px; background: var(--surface-sunken); font-size: 13px; }
      .mn-path { display: inline-flex; align-items: center; gap: 6px; padding: 1px 8px; border-radius: 8px; background: var(--surface-sunken); font-size: 13px; color: var(--ink-strong); text-decoration: none; white-space: nowrap; }
      .mn-path:hover { color: var(--brand-from); }
      .mn-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
      .mn-flow .fa-arrow-right { color: var(--ink-muted); font-size: 12px; }
      .mn-admin-head { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
      .mn-empty { display: none; }
    </style>
  @end

  @slot('main')
    <div class="flex flex-col gap-6">
      <div class="hic-pagehead" style="margin-bottom:0">
        <div class="hic-pagehead-title hic-tone-blue">
          <span class="hic-pagehead-icon"><i class="fas fa-book-open"></i></span>
          <div>
            <h1>คู่มือการใช้งาน</h1>
            <p>วิธีใช้งานระบบ HisReport ทีละขั้นตอน{{ mnIsAdmin ? ' · รวมคู่มือผู้ดูแลระบบ' : '' }}</p>
          </div>
        </div>
        <span class="hic-badge hic-badge-muted"><i class="fas fa-clock-rotate-left"></i>ปรับปรุงล่าสุด 9 ต.ค. 2569</span>
      </div>

      <div class="mn-layout">
        {{-- Table of contents --}}
        <aside class="mn-toc-wrap hic-panel" style="padding:12px">
