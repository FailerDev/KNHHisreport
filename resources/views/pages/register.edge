<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>สมัครสมาชิก · HisReport</title>
  @include('partials/head')
</head>
<body class="hic-body font-thai">
  @include('partials/auth_shell_start')

    <div class="mb-7">
      <h2 class="text-[28px] leading-10 font-bold" style="color:var(--ink-strong)">สมัครสมาชิก</h2>
      <p class="text-[15px] mt-1" style="color:var(--ink-subtle)">สร้างบัญชีเพื่อเข้าใช้งานระบบรายงานสถิติโรงพยาบาล</p>
    </div>

    @if(typeof success !== 'undefined' && success)
      <div class="hic-alert hic-alert-ok mb-5" role="status">
        <i class="fas fa-circle-check"></i>
        <span>{{ success }}</span>
      </div>
    @end

    @if(typeof error !== 'undefined' && error)
      <div class="hic-alert hic-alert-bad mb-5" role="alert">
        <i class="fas fa-circle-exclamation"></i>
        <span>{{ error }}</span>
      </div>
    @end

    <form method="POST" action="/register" class="space-y-4">
      {{ csrfField() }}

      <div>
        <label for="fullname" class="hic-label">ชื่อ-นามสกุล</label>
        <div class="hic-field-icon">
          <i class="fas fa-id-card"></i>
          <input type="text" id="fullname" name="fullname" value="{{ (old && old.fullname) || '' }}" required
            placeholder="เช่น สมชาย ใจดี" class="hic-input" />
        </div>
      </div>

      <div>
        <label for="username" class="hic-label">ชื่อผู้ใช้</label>
        <div class="hic-field-icon">
          <i class="fas fa-user"></i>
          <input type="text" id="username" name="username" value="{{ (old && old.username) || '' }}" required
            autocomplete="username" placeholder="ใช้สำหรับเข้าสู่ระบบ" class="hic-input" />
        </div>
      </div>

      <div>
        <label for="password" class="hic-label">รหัสผ่าน <small>(อย่างน้อย 6 ตัวอักษร)</small></label>
        <div class="hic-field-icon">
          <i class="fas fa-lock"></i>
          <input type="password" id="password" name="password" required minlength="6"
            autocomplete="new-password" placeholder="ตั้งรหัสผ่าน" class="hic-input" />
        </div>
      </div>

      <div>
        <label for="department" class="hic-label">แผนก <small>(ไม่บังคับ)</small></label>
        <div class="hic-field-icon">
          <i class="fas fa-building"></i>
          <input type="text" id="department" name="department" value="{{ (old && old.department) || '' }}"
            placeholder="เช่น งานเทคโนโลยีสารสนเทศ" class="hic-input" />
        </div>
      </div>

      <button type="submit" class="hic-btn hic-btn-primary hic-btn-lg hic-btn-block" style="margin-top:24px">
        <i class="fas fa-user-plus"></i><span>สมัครสมาชิก</span>
      </button>
    </form>

    <div class="mt-7 pt-5 text-center text-sm" style="border-top:1px solid var(--border);color:var(--ink-subtle)">
      มีบัญชีอยู่แล้ว? <a href="/login" class="font-semibold hover:underline" style="color:var(--brand-from)">เข้าสู่ระบบ</a>
    </div>

  @include('partials/auth_shell_end')

  <script src="/ui/hic.js" defer></script>
</body>
</html>
