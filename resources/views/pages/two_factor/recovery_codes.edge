<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>รหัสสำรอง 2FA · HisReport</title>
  @include('partials/head')
</head>
<body class="hic-body font-thai">
  @include('partials/auth_shell_start')

    <div class="mb-6">
      <span class="hic-metric-icon hic-tone-yellow mb-4" style="width:52px;height:52px;border-radius:16px;font-size:22px"><i class="fas fa-key"></i></span>
      <h2 class="text-[26px] leading-9 font-bold" style="color:var(--ink-strong)">บันทึกรหัสสำรองไว้</h2>
      <p class="text-[15px] mt-1" style="color:var(--ink-subtle)">ใช้แทนรหัสจากโทรศัพท์เมื่อโทรศัพท์หายหรือใช้งานไม่ได้ · ใช้ได้รหัสละ 1 ครั้ง</p>
    </div>

    <div class="hic-alert hic-alert-bad mb-5" role="alert">
      <i class="fas fa-eye-slash"></i>
      <span>รหัสชุดนี้แสดง <b>ครั้งเดียว</b> — พิมพ์ จด หรือเก็บไว้ในที่ปลอดภัยก่อนออกจากหน้านี้</span>
    </div>

    <div id="codes" class="grid grid-cols-2 gap-2 p-4 mb-4 hic-mono" style="background:var(--surface-sunken);border-radius:14px;font-size:16px;letter-spacing:.06em">
      @each(c in recoveryCodes)
        <span class="text-center py-1">{{ c.slice(0, 5) }}-{{ c.slice(5) }}</span>
      @end
    </div>

    <div class="flex gap-2 mb-6">
      <button type="button" class="hic-btn hic-btn-secondary flex-1" onclick="copyCodes(this)"><i class="fas fa-copy"></i><span>คัดลอก</span></button>
      <button type="button" class="hic-btn hic-btn-secondary flex-1" onclick="window.print()"><i class="fas fa-print"></i><span>พิมพ์</span></button>
    </div>

    <label class="flex items-start gap-2 text-sm mb-4 cursor-pointer">
      <input type="checkbox" id="saved" class="mt-1" />
      <span>ฉันบันทึกรหัสสำรองไว้เรียบร้อยแล้ว</span>
    </label>
    <a href="{{ continueUrl }}" id="goBtn" class="hic-btn hic-btn-primary hic-btn-lg hic-btn-block" style="opacity:.5;pointer-events:none" aria-disabled="true">
      <span>ไปต่อ</span><i class="fas fa-arrow-right"></i>
    </a>

  @include('partials/auth_shell_end')
  <script src="/ui/hic.js" defer></script>
  <script>
    document.getElementById('saved').addEventListener('change', (e) => {
      const go = document.getElementById('goBtn')
      go.style.opacity = e.target.checked ? 1 : 0.5
      go.style.pointerEvents = e.target.checked ? '' : 'none'
      go.setAttribute('aria-disabled', String(!e.target.checked))
    })
    function copyCodes(btn) {
      const text = [...document.querySelectorAll('#codes span')].map((s) => s.textContent.trim()).join('\n')
      navigator.clipboard?.writeText('HisReport — รหัสสำรอง 2FA\n' + text).then(() => {
        btn.querySelector('span').textContent = 'คัดลอกแล้ว'
      })
    }
  </script>
</body>
</html>
