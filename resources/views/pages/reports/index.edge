@component('layouts/app', {
  title: 'รายงานทั้งหมด · HisReport',
  showSidebar: true,
  isAdmin: auth.user.userLevel === 'admin',
  fullname: auth.user.fullname || auth.user.username,
  department: auth.user.department,
  currentPage: 'mainreport',
})
  @slot('main')
    @let(tones = ['blue', 'violet', 'teal', 'pink', 'indigo', 'green', 'yellow', 'sky'])
    <div class="flex flex-col gap-5">
      <div class="hic-pagehead" style="margin-bottom:0">
        <div class="hic-pagehead-title hic-tone-violet">
          <span class="hic-pagehead-icon"><i class="fas fa-file-lines"></i></span>
          <div>
            <h1>รายงานทั้งหมด</h1>
            <p>{{ stats.categories }} หมวดหมู่ · {{ stats.total }} รายงาน — เลือกหมวดหมู่ หรือพิมพ์ค้นหาได้ทันที</p>
          </div>
        </div>
        @if(auth.user.userLevel === 'admin')
          <a href="/admin/report-settings" class="hic-btn hic-btn-secondary">
            <i class="fas fa-sliders"></i><span>จัดการรายงาน</span>
          </a>
        @end
      </div>

      <div class="rp-toolbar">
        @if(heads.length > 0)
          {{-- Category dropdown --}}
          <div class="rp-dd" id="catDD">
            <button type="button" class="rp-dd-btn" id="catBtn" aria-haspopup="true" aria-expanded="false" aria-controls="catMenu">
              <span class="rp-dd-kicker">หมวดหมู่</span>
              <span class="rp-dd-value">
                <span class="rp-cat-dot" id="catCurrentDot"></span>
                <span class="rp-dd-label" id="catCurrent">ทั้งหมด</span>
                <span class="rp-cat-count" id="catCurrentCount"></span>
              </span>
              <i class="fas fa-chevron-down rp-dd-caret"></i>
            </button>
            <div class="rp-dd-menu" id="catMenu" hidden>
              <nav class="rp-cats" id="catNav" aria-label="หมวดหมู่รายงาน">
                <button type="button" class="rp-cat" data-cat="all" title="ทั้งหมด">
                  <span class="rp-cat-dot" style="background:var(--ink-muted)"></span>
                  <span class="rp-cat-name">ทั้งหมด</span>
                  <span class="rp-cat-count" data-total="{{ stats.total }}">{{ stats.total }}</span>
                </button>
                @each((h, hIdx) in heads)
                  @let(list = reportsByHead[h.id] || [])
                  <button type="button" class="rp-cat hic-tone-{{ tones[hIdx % tones.length] }} {{ list.length === 0 ? 'is-zero' : '' }}" data-cat="{{ h.id }}"
                    title="{{ stripTitleHtml(h.detail) }}">
                    <span class="rp-cat-dot"></span>
                    <span class="rp-cat-name">{{ stripTitleHtml(h.detail) }}</span>
                    <span class="rp-cat-count" data-total="{{ list.length }}">{{ list.length }}</span>
                  </button>
                @end
              </nav>
            </div>
          </div>
        @end

        {{-- Search --}}
        <label class="hic-search rp-search">
          <i class="fas fa-magnifying-glass"></i>
          <input id="reportSearch" type="search" value="{{ search }}" placeholder="ค้นหาชื่อรายงานจากทุกหมวด…" autocomplete="off" />
          <span id="hits" class="hic-badge hic-badge-brand hidden"><span id="hitCount">0</span> รายการ</span>
          <kbd class="hic-kbd hidden md:inline">/</kbd>
        </label>
      </div>

      {{-- Recently opened (per-browser) --}}
      <div id="recentWrap" class="hidden">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-sm font-semibold mr-1" style="color:var(--ink-subtle)"><i class="fas fa-clock-rotate-left mr-1"></i>เปิดล่าสุด</span>
          <div id="recentList" class="flex gap-2 flex-wrap"></div>
        </div>
      </div>

      @if(heads.length === 0)
        <div class="hic-panel">
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-folder-open"></i></span>
            <b>ยังไม่มีรายงานในระบบ</b>
          </div>
        </div>
      @else
        <div>
          {{-- Report lists --}}
          <div id="reportGrid" class="flex flex-col gap-5 min-w-0">
            @each((h, hIdx) in heads)
              @let(list = reportsByHead[h.id] || [])
              <section class="rp-sec hic-panel hic-tone-{{ tones[hIdx % tones.length] }}" data-cat="{{ h.id }}"
                data-category="{{ stripTitleHtml(h.detail).toLowerCase() }}">
                <header class="rp-sec-head">
                  <span class="hic-metric-icon" style="width:40px;height:40px;border-radius:12px;font-size:15px"><i class="fas fa-folder-open"></i></span>
                  <h2>{{{ safeReportTitle(h.detail) }}}</h2>
                  <span class="hic-pill rp-sec-count">{{ list.length }}</span>
                </header>
                @if(list.length === 0)
                  <div class="py-8 text-center text-sm" style="color:var(--ink-muted)">ไม่มีรายงานในหมวดนี้</div>
                @else
                  <ol class="rp-list">
                    @each(r in list)
                      @let(src = r.databaseSource || 'system')
                      @let(t = reportTitleParts(r.detail))
                      <li>
                        <a href="/reports/{{ r.id }}" class="report-item" data-id="{{ r.id }}" data-name="{{ stripTitleHtml(r.detail).toLowerCase() }}"
                          title="{{ stripTitleHtml(r.detail) }}">
                          @if(t.no)
                            <span class="rp-num">{{ t.no }}</span>
                          @else
                            <span class="rp-num rp-num-none"><i class="fas fa-file-lines"></i></span>
                          @end
                          <span class="rp-body">
                            <span class="rp-title">{{ t.title }}</span>
                            @if(t.notes.length || src !== 'his')
                              <span class="rp-tags">
                                @if(src !== 'his')
                                  <span class="rp-tag rp-tag-src"><i class="fas fa-database"></i>ระบบ</span>
                                @end
                                @each(n in t.notes)
                                  <span class="rp-tag rp-tag-{{ n.tone }}">{{ n.text }}</span>
                                @end
                              </span>
                            @end
                          </span>
                          <i class="fas fa-chevron-right rp-go"></i>
                        </a>
                      </li>
                    @end
                  </ol>
                @end
              </section>
            @end

            <div id="noResults" class="hidden hic-panel">
              <div class="hic-empty">
                <span class="hic-empty-icon"><i class="fas fa-magnifying-glass"></i></span>
                <b>ไม่พบรายงานที่ตรงกับการค้นหา</b>
                <span>ลองใช้คำที่สั้นลง หรือค้นหาด้วยชื่อหมวด</span>
                <button type="button" id="clearSearch" class="hic-btn hic-btn-secondary hic-btn-sm mt-3">
                  <i class="fas fa-rotate-left"></i>ล้างคำค้นหา
                </button>
              </div>
            </div>
          </div>
        </div>
      @end
    </div>

    <style>
      .rp-list { margin: 0; padding: 8px; list-style: none; column-width: 440px; column-gap: 8px; }
      .rp-list > li { break-inside: avoid; }
      .report-item {
        display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px; border-radius: 12px;
        color: var(--ink-strong); text-decoration: none; transition: background-color .12s ease;
      }
      .report-item:hover { background: color-mix(in srgb, var(--tile) 60%, transparent); }
      .report-item:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
      .rp-go { flex: none; margin-top: 6px; font-size: 11px; color: var(--ink-muted); opacity: 0; transition: opacity .12s ease, transform .12s ease; }
      .report-item:hover .rp-go { opacity: 1; color: var(--tone-ink); transform: translateX(2px); }

      .rp-recent {
        display: inline-flex; align-items: center; gap: 8px; max-width: 320px; height: 34px; padding: 0 12px;
        border: 1px solid var(--border); border-radius: 9999px; background: var(--surface);
        color: var(--ink); text-decoration: none; font-size: 13.5px; transition: background-color .12s ease, border-color .12s ease;
      }
      .rp-recent:hover { border-color: var(--brand-from); color: var(--brand-from); }
      .rp-recent span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rp-recent i { font-size: 11px; color: var(--ink-muted); }

      @media (max-width: 640px) {
        .rp-list { padding: 4px; }
        .report-item { padding: 10px 8px; gap: 10px; }
      }
    </style>
    <script>
      (function () {
        const search = document.getElementById('reportSearch')
        const grid = document.getElementById('reportGrid')
        if (!grid) return
        const sections = Array.from(grid.querySelectorAll('.rp-sec'))
        const cats = Array.from(document.querySelectorAll('.rp-cat'))
        const noResults = document.getElementById('noResults')
        const hits = document.getElementById('hits')
        const hitCount = document.getElementById('hitCount')
        const STORE_CAT = 'hr-report-cat'
        const STORE_RECENT = 'hr-recent-reports'

        const store = {
          get(k) { try { return localStorage.getItem(k) } catch (e) { return null } },
          set(k, v) { try { localStorage.setItem(k, v) } catch (e) {} },
        }

        const catBtn = document.getElementById('catBtn')
        const catMenu = document.getElementById('catMenu')
        const catCurrent = document.getElementById('catCurrent')
        const catCurrentCount = document.getElementById('catCurrentCount')
        const catCurrentDot = document.getElementById('catCurrentDot')
        function openMenu(on) {
          catMenu.hidden = !on
          catBtn.setAttribute('aria-expanded', String(on))
          if (on) (catMenu.querySelector('.rp-cat.is-active') || cats[0])?.focus()
        }
        catBtn.addEventListener('click', () => openMenu(catMenu.hidden))
        document.addEventListener('click', e => { if (!catMenu.hidden && !e.target.closest('#catDD')) openMenu(false) })
        catMenu.addEventListener('keydown', e => {
          const i = cats.indexOf(document.activeElement)
          if (e.key === 'Escape') { openMenu(false); catBtn.focus() }
          else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault()
            cats[(i + (e.key === 'ArrowDown' ? 1 : cats.length - 1)) % cats.length]?.focus()
          }
        })

        let current = store.get(STORE_CAT)
        if (!current || !cats.some(c => c.dataset.cat === current)) current = sections[0]?.dataset.cat || 'all'

        const esc = t => t.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
        function highlight(el, q) {
          if (!el) return
          if (el.dataset.raw === undefined) el.dataset.raw = el.textContent
          const raw = el.dataset.raw
          const at = q ? raw.toLowerCase().indexOf(q) : -1
          if (at < 0) { if (el.dataset.marked) { el.textContent = raw; delete el.dataset.marked } return }
          el.innerHTML = esc(raw.slice(0, at)) + '<mark>' + esc(raw.slice(at, at + q.length)) + '</mark>' + esc(raw.slice(at + q.length))
          el.dataset.marked = '1'
        }

        function render() {
          const q = (search.value || '').trim().toLowerCase()
          let total = 0

          sections.forEach(sec => {
            const items = sec.querySelectorAll('.report-item')
            const catMatch = q && (sec.dataset.category || '').includes(q)
            let shown = 0
            items.forEach(item => {
              const ok = !q || catMatch || (item.dataset.name || '').includes(q)
              item.parentElement.style.display = ok ? '' : 'none'
              if (ok) shown++
              highlight(item.querySelector('.rp-title'), ok ? q : '')
            })
            total += shown
            sec.querySelector('.rp-sec-count').textContent = shown
            const navBtn = cats.find(c => c.dataset.cat === sec.dataset.cat)
            if (navBtn) {
              const countEl = navBtn.querySelector('.rp-cat-count')
              countEl.textContent = q ? shown : countEl.dataset.total
              navBtn.classList.toggle('is-empty', !!q && shown === 0)
            }
            // While searching, show every section that has hits; otherwise only the selected one.
            const visible = q ? shown > 0 : (current === 'all' || sec.dataset.cat === current)
            sec.style.display = visible ? '' : 'none'
          })

          const allBtn = cats.find(c => c.dataset.cat === 'all')
          if (allBtn) allBtn.querySelector('.rp-cat-count').textContent = q ? total : allBtn.querySelector('.rp-cat-count').dataset.total

          cats.forEach(c => c.classList.toggle('is-active', q ? c.dataset.cat === 'all' : c.dataset.cat === current))
          const activeBtn = cats.find(c => c.classList.contains('is-active'))
          if (activeBtn) {
            catCurrent.textContent = q ? 'ผลค้นหาทุกหมวด' : activeBtn.title
            catCurrentCount.textContent = activeBtn.querySelector('.rp-cat-count').textContent
            catCurrentDot.style.background = getComputedStyle(activeBtn.querySelector('.rp-cat-dot')).backgroundColor
          }
          noResults.classList.toggle('hidden', !q || total > 0)
          hits.classList.toggle('hidden', !q)
          hitCount.textContent = total
        }

        cats.forEach(btn => btn.addEventListener('click', () => {
          const cat = btn.dataset.cat
          openMenu(false)
          if (search.value.trim()) {
            // During a search, the nav jumps to that category's results instead of filtering.
            const sec = sections.find(s => s.dataset.cat === cat)
            if (sec && sec.style.display !== 'none') sec.scrollIntoView({ behavior: 'smooth', block: 'start' })
            else if (cat === 'all') window.scrollTo({ top: 0, behavior: 'smooth' })
            return
          }
          current = cat
          store.set(STORE_CAT, cat)
          render()
          const top = grid.getBoundingClientRect().top + window.scrollY - 100
          if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' })
        }))

        let timer = null
        search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(render, 80) })
        document.getElementById('clearSearch')?.addEventListener('click', () => { search.value = ''; render(); search.focus() })
        document.addEventListener('keydown', e => {
          const tag = document.activeElement?.tagName
          if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') { e.preventDefault(); search.focus() }
          if (e.key === 'Escape' && document.activeElement === search && search.value) { search.value = ''; render() }
        })

        // Recently opened reports (stored only in this browser)
        function readRecent() {
          try { return JSON.parse(store.get(STORE_RECENT) || '[]') } catch (e) { return [] }
        }
        grid.addEventListener('click', e => {
          const a = e.target.closest('.report-item')
          if (!a) return
          const name = a.querySelector('.rp-title').textContent.trim()
          const list = readRecent().filter(r => r.id !== a.dataset.id)
          list.unshift({ id: a.dataset.id, name })
          store.set(STORE_RECENT, JSON.stringify(list.slice(0, 6)))
        })
        const recent = readRecent().filter(r => grid.querySelector('.report-item[data-id="' + r.id + '"]'))
        if (recent.length) {
          const wrap = document.getElementById('recentList')
          recent.forEach(r => {
            const a = document.createElement('a')
            a.className = 'rp-recent'
            a.href = '/reports/' + encodeURIComponent(r.id)
            a.title = r.name
            a.innerHTML = '<i class="fas fa-file-lines"></i><span></span>'
            a.querySelector('span').textContent = r.name
            wrap.appendChild(a)
          })
          document.getElementById('recentWrap').classList.remove('hidden')
        }

        render()
      })()
    </script>
  @end
@end
