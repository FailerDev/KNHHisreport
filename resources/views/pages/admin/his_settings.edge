@component('layouts/app', {
  title: 'ตั้งค่า HIS Database · HisReport',
  showSidebar: true,
  isAdmin: true,
  fullname: auth?.user?.fullname || auth?.user?.username,
  department: auth?.user?.department,
  currentPage: 'his-settings',
})
  @slot('main')
    @let(connOk = status.connected)
    @let(hasConfig = status.hasConfig)
    @let(stateTone = connOk ? 'green' : (hasConfig ? 'red' : 'yellow'))
    @let(stateBadge = connOk ? 'hic-badge-ok' : (hasConfig ? 'hic-badge-bad' : 'hic-badge-warn'))
    @let(stateLbl = connOk ? 'เชื่อมต่อได้' : (hasConfig ? 'เชื่อมต่อไม่ได้' : 'ยังไม่ได้ตั้งค่า'))
    @let(stateIcon = connOk ? 'fa-circle-check' : (hasConfig ? 'fa-plug-circle-xmark' : 'fa-triangle-exclamation'))
    @let(hasSavedPwd = current && current.dbPassword)

    <div class="max-w-5xl mx-auto flex flex-col gap-6">
      <div class="hic-pagehead" style="margin-bottom:0">
        <div class="hic-pagehead-title hic-tone-yellow">
          <span class="hic-pagehead-icon"><i class="fas fa-database"></i></span>
          <div>
            <h1>ตั้งค่า HIS Database</h1>
            <p>การเชื่อมต่อกับฐานข้อมูล HIS ของโรงพยาบาล (อ่านอย่างเดียว)</p>
          </div>
        </div>
      </div>

      @include('partials/flash')

      {{-- Status hero --}}
      <section class="hic-panel hic-rise hic-tone-{{ stateTone }} relative overflow-hidden">
        <div class="absolute inset-y-0 left-0 w-1.5" style="background:var(--tone-ink)"></div>
        <div class="p-5 pl-7 flex flex-wrap items-center gap-4">
          <span class="hic-metric-icon" style="width:52px;height:52px;border-radius:16px;font-size:22px"><i class="fas {{ stateIcon }}"></i></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <b style="font-size:16px;color:var(--ink-strong)">สถานะการเชื่อมต่อ HIS</b>
              <span class="hic-badge {{ stateBadge }}"><span class="hic-dot {{ connOk ? 'pulse' : '' }}"></span>{{ stateLbl }}</span>
            </div>
            <div class="text-sm mt-1 break-words" style="color:var(--ink-subtle)">{{ status.message }}</div>
            @if(status.debug)
              <details class="mt-2 text-xs" style="color:var(--ink-subtle)">
                <summary class="cursor-pointer font-semibold">รายละเอียดทางเทคนิค</summary>
                <pre class="hic-mono mt-2 p-3 rounded-xl overflow-x-auto" style="background:var(--surface-sunken)">{{ status.debug }}</pre>
              </details>
            @end
          </div>
        </div>

        @if(current)
          <div class="px-7 pb-5">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3 pt-4" style="border-top:1px dashed var(--border-strong)">
              <div><div class="text-xs" style="color:var(--ink-subtle)"><i class="fas fa-server mr-1"></i>Host</div><div class="font-semibold hic-mono mt-0.5 break-all" style="color:var(--ink-strong)">{{ current.dbHost }}</div></div>
              <div><div class="text-xs" style="color:var(--ink-subtle)"><i class="fas fa-plug mr-1"></i>Port</div><div class="font-semibold hic-mono mt-0.5" style="color:var(--ink-strong)">{{ current.dbPort }}</div></div>
              <div><div class="text-xs" style="color:var(--ink-subtle)"><i class="fas fa-database mr-1"></i>Database</div><div class="font-semibold hic-mono mt-0.5 break-all" style="color:var(--ink-strong)">{{ current.dbName }}</div></div>
              <div><div class="text-xs" style="color:var(--ink-subtle)"><i class="fas fa-user mr-1"></i>User</div><div class="font-semibold hic-mono mt-0.5 break-all" style="color:var(--ink-strong)">{{ current.dbUsername }}</div></div>
              <div><div class="text-xs" style="color:var(--ink-subtle)"><i class="fas fa-key mr-1"></i>Password</div>
                <div class="mt-0.5">
                  @if(hasSavedPwd)
                    <span class="font-semibold" style="color:var(--ink-strong)">••••••••</span>
                  @else
                    <span class="hic-badge hic-badge-warn">ว่าง</span>
                  @end
                </div>
              </div>
            </div>
            @if(current.updatedAt)
              <div class="text-xs mt-3" style="color:var(--ink-muted)"><i class="fas fa-clock mr-1"></i>อัปเดตล่าสุด {{ current.updatedAt.toFormat('dd/MM/yyyy HH:mm') }}</div>
            @end
          </div>
        @end
      </section>

      {{-- Settings form --}}
      <div class="hic-panel">
        <div class="hic-panel-head">
          <div>
            <h2><i class="fas fa-sliders" style="color:var(--heading)"></i>การตั้งค่าการเชื่อมต่อ</h2>
            <p>กรอกข้อมูล → ทดสอบการเชื่อมต่อ → บันทึก</p>
          </div>
          <div class="flex items-center gap-1.5 text-xs font-semibold" style="color:var(--ink-subtle)">
            <span class="hic-badge hic-badge-brand">1 กรอก</span><i class="fas fa-chevron-right" style="font-size:9px"></i>
            <span class="hic-badge hic-badge-warn">2 ทดสอบ</span><i class="fas fa-chevron-right" style="font-size:9px"></i>
            <span class="hic-badge hic-badge-ok">3 บันทึก</span>
          </div>
        </div>

        <form id="hisForm" method="POST" action="/admin/his-settings" class="hic-panel-body flex flex-col gap-6">
          {{ csrfField() }}

          <section>
            <div class="his-sec"><i class="fas fa-network-wired"></i>ที่อยู่เซิร์ฟเวอร์</div>
            <div class="grid grid-cols-1 md:grid-cols-[1fr_12rem] gap-4">
              <div>
                <label for="hf_host" class="hic-label">โฮสต์ (Host) <span class="hic-req">*</span></label>
                <div class="hic-field-icon">
                  <i class="fas fa-server"></i>
                  <input id="hf_host" name="db_host_his" type="text" required
                    value="{{ (current && current.dbHost) || '30.23.2.1' }}"
                    placeholder="localhost หรือ IP Address" autocomplete="off" class="hic-input" />
                </div>
                <div class="hic-help">เช่น <code class="hic-mono">localhost</code>, <code class="hic-mono">192.168.1.10</code></div>
              </div>
              <div>
                <label for="hf_port" class="hic-label">พอร์ต (Port)</label>
                <div class="hic-field-icon">
                  <i class="fas fa-plug"></i>
                  <input id="hf_port" name="db_port_his" type="number" min="1" max="65535"
                    value="{{ (current && current.dbPort) || '3306' }}" placeholder="3306" class="hic-input" />
                </div>
                <div class="hic-help">ค่าเริ่มต้น <code class="hic-mono">3306</code></div>
              </div>
            </div>
          </section>

          <section>
            <div class="his-sec"><i class="fas fa-database"></i>ฐานข้อมูล</div>
            <div>
              <label for="hf_db" class="hic-label">ชื่อฐานข้อมูล <span class="hic-req">*</span></label>
              <div class="hic-field-icon">
                <i class="fas fa-database"></i>
                <input id="hf_db" name="db_name_his" type="text" required
                  value="{{ (current && current.dbName) || 'hos' }}"
                  placeholder="ชื่อฐานข้อมูล HIS" autocomplete="off" class="hic-input" />
              </div>
            </div>
          </section>

          <section>
            <div class="his-sec"><i class="fas fa-user-shield"></i>ข้อมูลรับรอง</div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="hf_user" class="hic-label">ชื่อผู้ใช้ <span class="hic-req">*</span></label>
                <div class="hic-field-icon">
                  <i class="fas fa-user"></i>
                  <input id="hf_user" name="db_username_his" type="text" required
                    value="{{ (current && current.dbUsername) || 'knh' }}"
                    placeholder="ชื่อผู้ใช้ฐานข้อมูล" autocomplete="off" class="hic-input" />
                </div>
              </div>
              <div>
                <label for="hf_pass" class="hic-label">
                  รหัสผ่าน
                  @if(!hasSavedPwd)
                    <span class="hic-req">*</span>
                  @end
                </label>
                <div class="hic-field-icon">
                  <i class="fas fa-key"></i>
                  <input id="hf_pass" name="db_password_his" type="password"
                    placeholder="{{ hasSavedPwd ? 'ปล่อยว่างเพื่อใช้รหัสที่บันทึกไว้' : 'กรอกรหัสผ่านฐานข้อมูล' }}"
                    autocomplete="new-password" {{ hasSavedPwd ? '' : 'required' }}
                    class="hic-input" style="padding-right:48px" />
                  <button type="button" id="hisPwdToggle" class="hic-iconbtn" aria-label="แสดง/ซ่อนรหัสผ่าน" style="width:34px;height:34px;font-size:13px">
                    <i id="hisPwdIcon" class="fas fa-eye"></i>
                  </button>
                </div>
                <div class="hic-help flex items-start gap-1.5" style="color:{{ hasSavedPwd ? 'var(--ok)' : 'var(--warn)' }}">
                  <i class="fas {{ hasSavedPwd ? 'fa-circle-check' : 'fa-triangle-exclamation' }} mt-0.5"></i>
                  <span>
                    @if(hasSavedPwd)
                      มีรหัสผ่านบันทึกไว้แล้ว — ปล่อยว่างจะใช้ของเดิม กรอกใหม่ถ้าต้องการเปลี่ยน
                    @else
                      จำเป็นต้องกรอกรหัสผ่าน
                    @end
                  </span>
                </div>
              </div>
            </div>
          </section>

          <div id="testResult" class="hidden"></div>

          <div class="pt-5 flex flex-wrap justify-end gap-2" style="border-top:1px solid var(--border)">
            <button type="button" id="testButton" onclick="testConnection()" class="hic-btn hic-btn-warn hic-btn-lg">
              <i class="fas fa-vial"></i><span>ทดสอบการเชื่อมต่อ</span>
            </button>
            <button type="submit" id="saveButton" class="hic-btn hic-btn-primary hic-btn-lg">
              <i class="fas fa-floppy-disk"></i><span>บันทึกการตั้งค่า</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <style>
      .his-sec {
        display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
        font: 700 12.5px/18px var(--font-thai); letter-spacing: .04em; color: var(--ink-subtle);
      }
      .his-sec i { color: var(--heading); }
      .his-sec::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    </style>

    <script>
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])
      }

      // Password show/hide
      document.getElementById('hisPwdToggle')?.addEventListener('click', () => {
        const inp = document.getElementById('hf_pass')
        const icon = document.getElementById('hisPwdIcon')
        const isText = inp.type === 'text'
        inp.type = isText ? 'password' : 'text'
        icon.className = isText ? 'fas fa-eye' : 'fas fa-eye-slash'
      })

      document.getElementById('hisForm').addEventListener('submit', () => {
        const btn = document.getElementById('saveButton')
        btn.disabled = true
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>กำลังบันทึก…</span>'
      })

      async function testConnection() {
        const form = document.getElementById('hisForm')
        const fd = new FormData(form)
        const btn = document.getElementById('testButton')
        const tr = document.getElementById('testResult')
        const original = btn.innerHTML
        btn.disabled = true
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>กำลังทดสอบ…</span>'
        tr.className = 'hic-alert hic-alert-info'
        tr.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>กำลังทดสอบการเชื่อมต่อ HIS Database…</span>'
        try {
          const res = await fetch('/admin/his-settings/test', { method: 'POST', body: fd })
          const result = await res.json()
          if (result.success) {
            tr.className = 'hic-alert hic-alert-ok'
            tr.innerHTML = '<i class="fas fa-circle-check"></i><div class="flex-1">'
              + '<div class="font-bold">การทดสอบสำเร็จ</div>'
              + '<div class="text-xs mt-1">' + esc(result.message) + '</div>'
              + (result.database ? '<div class="text-xs mt-2 grid grid-cols-2 md:grid-cols-4 gap-2">'
                  + '<div><b>ฐานข้อมูล:</b> ' + esc(result.database) + '</div>'
                  + '<div><b>โฮสต์:</b> ' + esc(result.host) + ':' + esc(result.port) + '</div>'
                  + '<div><b>ผู้ใช้:</b> ' + esc(result.username) + '</div>'
                  + (result.mysql_version ? '<div><b>MySQL:</b> ' + esc(result.mysql_version) + '</div>' : '')
                + '</div>' : '')
              + '</div>'
          } else {
            tr.className = 'hic-alert hic-alert-bad'
            tr.innerHTML = '<i class="fas fa-circle-exclamation"></i><div class="flex-1">'
              + '<div class="font-bold">การทดสอบล้มเหลว</div>'
              + '<div class="text-xs mt-1">' + esc(result.message) + '</div>'
              + (result.debug ? '<div class="hic-mono mt-1 opacity-80 break-all">' + esc(result.debug) + '</div>' : '')
              + '</div>'
          }
        } catch (e) {
          tr.className = 'hic-alert hic-alert-bad'
          tr.innerHTML = '<i class="fas fa-circle-exclamation"></i><span>เกิดข้อผิดพลาด: ' + esc(e.message || e) + '</span>'
        } finally {
          btn.disabled = false
          btn.innerHTML = original
        }
      }
    </script>
  @end
@end
