@component('layouts/app', {
  title: 'ตั้งค่ารายงาน · HisReport',
  showSidebar: true,
  isAdmin: true,
  fullname: auth.user.fullname || auth.user.username,
  department: auth.user.department,
  currentPage: 'report-settings',
})
  @slot('main')
    @let(tones = ['blue', 'violet', 'teal', 'pink', 'indigo', 'green', 'yellow', 'sky'])
    @let(totalReports = heads.reduce((n, h) => n + (reportsByHead[h.id] || []).length, 0))
    <div class="flex flex-col gap-6">
      @let(settingsTab = 'report-settings')
      @include('partials/settings_nav')
      <div class="hic-pagehead" style="margin-bottom:0">
        <div class="hic-pagehead-title hic-tone-indigo">
          <span class="hic-pagehead-icon"><i class="fas fa-sliders"></i></span>
          <div>
            <h1>ตั้งค่ารายงาน</h1>
            <p>จัดการหมวดหมู่ รายงาน และ SQL template พร้อมทดสอบ SQL</p>
          </div>
        </div>
        <div class="flex gap-2 flex-wrap">
          <button type="button" onclick="openHeadModal()" class="hic-btn hic-btn-secondary">
            <i class="fas fa-folder-plus"></i><span>เพิ่มหมวดหมู่</span>
          </button>
          <button type="button" onclick="openReportModal()" class="hic-btn hic-btn-primary">
            <i class="fas fa-plus"></i><span>เพิ่มรายงาน</span>
          </button>
        </div>
      </div>

      @include('partials/flash')

      <div class="hic-metrics">
        <div class="hic-metric hic-tone-blue hic-rise" style="--i:0">
          <span class="hic-metric-icon"><i class="fas fa-folder-tree"></i></span>
          <div><div class="hic-metric-label">หมวดหมู่</div><div class="hic-metric-value">{{ heads.length }}</div></div>
        </div>
        <div class="hic-metric hic-tone-violet hic-rise" style="--i:1">
          <span class="hic-metric-icon"><i class="fas fa-file-lines"></i></span>
          <div><div class="hic-metric-label">รายงานทั้งหมด</div><div class="hic-metric-value">{{ totalReports }}</div></div>
        </div>
      </div>

      @if(heads.length === 0)
        <div class="hic-panel">
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-folder-open"></i></span>
            <b>ยังไม่มีหมวดหมู่ในระบบ</b>
            <span>เริ่มต้นด้วยการสร้างหมวดหมู่แรก</span>
            <button type="button" onclick="openHeadModal()" class="hic-btn hic-btn-secondary hic-btn-sm mt-3"><i class="fas fa-folder-plus"></i>เพิ่มหมวดหมู่</button>
          </div>
        </div>
      @else
        <div class="rp-toolbar">
          {{-- Category dropdown --}}
          <div class="rp-dd" id="catDD">
            <button type="button" class="rp-dd-btn" id="catBtn" aria-haspopup="true" aria-expanded="false" aria-controls="catMenu">
              <span class="rp-dd-kicker">หมวดหมู่</span>
              <span class="rp-dd-value">
                <span class="rp-cat-dot" id="catCurrentDot"></span>
                <span class="rp-dd-label" id="catCurrent">ทั้งหมด</span>
                <span class="rp-cat-count" id="catCurrentCount"></span>
              </span>
              <i class="fas fa-chevron-down rp-dd-caret"></i>
            </button>
            <div class="rp-dd-menu" id="catMenu" hidden>
              <nav class="rp-cats" aria-label="หมวดหมู่รายงาน">
                <button type="button" class="rp-cat" data-cat="all" title="ทั้งหมด">
                  <span class="rp-cat-dot" style="background:var(--ink-muted)"></span>
                  <span class="rp-cat-name">ทั้งหมด</span>
                  <span class="rp-cat-count" data-total="{{ totalReports }}">{{ totalReports }}</span>
                </button>
                @each((h, hIdx) in heads)
                  @let(list = reportsByHead[h.id] || [])
                  <button type="button" class="rp-cat hic-tone-{{ tones[hIdx % tones.length] }} {{ list.length === 0 ? 'is-zero' : '' }}" data-cat="{{ h.id }}"
                    title="{{ stripTitleHtml(h.detail) }}">
                    <span class="rp-cat-dot"></span>
                    <span class="rp-cat-name">{{ stripTitleHtml(h.detail) }}</span>
                    <span class="rp-cat-count" data-total="{{ list.length }}">{{ list.length }}</span>
                  </button>
                @end
              </nav>
            </div>
          </div>

          {{-- Search --}}
          <label class="hic-search rp-search">
            <i class="fas fa-magnifying-glass"></i>
            <input id="rsSearch" type="search" placeholder="ค้นหาชื่อรายงาน หรือคำใน SQL (เช่น ชื่อตาราง)…" autocomplete="off" />
            <span id="hits" class="hic-badge hic-badge-brand hidden"><span id="hitCount">0</span> รายการ</span>
          </label>
        </div>
      @end

      <div id="rsGrid" class="flex flex-col gap-5">
        @each((h, hIdx) in heads)
          @let(list = reportsByHead[h.id] || [])
          <section class="rp-sec hic-panel hic-tone-{{ tones[hIdx % tones.length] }}" data-cat="{{ h.id }}"
            data-category="{{ stripTitleHtml(h.detail).toLowerCase() }}">
            <header class="rp-sec-head">
              <span class="hic-metric-icon" style="width:40px;height:40px;border-radius:12px;font-size:15px"><i class="fas fa-folder-open"></i></span>
              <div class="min-w-0 flex-1">
                <h2>{{{ safeReportTitle(h.detail) }}}</h2>
                <div class="rs-sub">ลำดับหมวด {{ h.sort }}</div>
              </div>
              <span class="hic-pill rp-sec-count">{{ list.length }}</span>
              <div class="flex gap-1">
                <button type="button" title="เพิ่มรายงานในหมวดนี้" class="hic-act is-ok"
                  onclick="openReportModal({ head_id: {{ h.id }} })"><i class="fas fa-plus"></i></button>
                <button type="button" title="แก้ไขหมวดหมู่" class="hic-act is-brand"
                  onclick="openHeadModal({{ JSON.stringify({ id: h.id, detail: h.detail, sort: h.sort }) }})"><i class="fas fa-pen"></i></button>
                <button type="button" title="ลบหมวดหมู่" class="hic-act is-bad"
                  onclick="confirmDeleteHead({{ h.id }}, {{ JSON.stringify(stripTitleHtml(h.detail)) }})"><i class="fas fa-trash"></i></button>
              </div>
            </header>

            @if(list.length === 0)
              <div class="py-8 text-center text-sm" style="color:var(--ink-muted)">
                <i class="fas fa-inbox text-xl mb-1"></i>
                <div>ไม่มีรายงานในหมวดนี้</div>
              </div>
            @else
              <div class="overflow-x-auto">
                <table class="hic-table rs-table">
                  <thead>
                    <tr>
                      <th style="width:64px"></th>
                      <th>รายงาน</th>
                      <th style="width:96px">ฐานข้อมูล</th>
                      <th style="width:70px;text-align:center">ลำดับ</th>
                      <th style="width:132px;text-align:right">จัดการ</th>
                    </tr>
                  </thead>
                  <tbody>
                    @each(r in list)
                      @let(src = r.databaseSource || 'system')
                      @let(t = reportTitleParts(r.detail))
                      <tr id="report-row-{{ r.id }}" class="rs-row" data-report-id="{{ r.id }}" data-name="{{ stripTitleHtml(r.detail).toLowerCase() }}"
                        data-report="{{ JSON.stringify({ id: r.id, head_id: r.headId, detail: r.detail, sql1: r.sql1, sql2: r.sql2, database_source: src, sort: r.sort }) }}">
                        <td>
                          @if(t.no)
                            <span class="rp-num">{{ t.no }}</span>
                          @else
                            <span class="rp-num rp-num-none"><i class="fas fa-file-lines"></i></span>
                          @end
                        </td>
                        <td>
                          <div class="rp-body">
                            <a href="/reports/{{ r.id }}" class="rp-title rs-title" title="{{ stripTitleHtml(r.detail) }}">{{ t.title }}</a>
                            @if(t.notes.length)
                              <span class="rp-tags">
                                @each(n in t.notes)
                                  <span class="rp-tag rp-tag-{{ n.tone }}">{{ n.text }}</span>
                                @end
                              </span>
                            @end
                            <div class="hic-mono rs-sql">{{ (r.sql1 || '').replace(/\s+/g, ' ').trim().slice(0, 160) }}</div>
                          </div>
                        </td>
                        <td>
                          <span class="hic-badge {{ src === 'his' ? 'hic-badge-violet' : 'hic-badge-brand' }}">
                            <i class="fas fa-database"></i>{{ src === 'his' ? 'HIS' : 'ระบบ' }}
                          </span>
                        </td>
                        <td style="text-align:center;font-variant-numeric:tabular-nums">{{ r.sort }}</td>
                        <td>
                          <div class="flex justify-end gap-1">
                            <a href="/admin/reports/{{ r.id }}/parameters" title="พารามิเตอร์" class="hic-act is-warn"><i class="fas fa-list-check"></i></a>
                            <button type="button" title="แก้ไข" data-edit-report="{{ r.id }}" class="hic-act is-brand"
                              onclick="openReportModal(JSON.parse(this.closest('tr').dataset.report))"><i class="fas fa-pen"></i></button>
                            <button type="button" title="ลบ" class="hic-act is-bad"
                              onclick="confirmDeleteReport({{ r.id }}, {{ JSON.stringify(stripTitleHtml(r.detail)) }})"><i class="fas fa-trash"></i></button>
                          </div>
                        </td>
                      </tr>
                    @end
                  </tbody>
                </table>
              </div>
            @end
          </section>
        @end

        <div id="noResults" class="hidden hic-panel">
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-magnifying-glass"></i></span>
            <b>ไม่พบรายงานที่ตรงกับการค้นหา</b>
          </div>
        </div>
      </div>
    </div>

    <style>
      .rs-sub { margin-top: 1px; font-size: 12px; color: var(--ink-subtle); }
      .rs-table td { vertical-align: top; }
      .rs-table tbody tr:nth-child(even) td { background: transparent; }
      .rs-table tbody tr:hover td { background: color-mix(in srgb, var(--tile) 45%, transparent); }
      .rs-title { color: var(--ink-strong); text-decoration: none; }
      .rs-title:hover { color: var(--tone-ink); text-decoration: underline; }
      .rs-sql { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 760px; color: var(--ink-muted); font-size: 12px; }
      .rs-row.is-flash td { background: var(--warn-soft) !important; transition: background-color .4s ease; }
    </style>

    {{-- Head modal --}}
    <div id="headModal" class="hic-modal hidden" role="dialog" aria-modal="true">
      <div class="hic-modal-box is-sm hic-tone-blue">
        <div class="hic-modal-head">
          <span class="hic-modal-icon"><i class="fas fa-folder"></i></span>
          <h3 id="headModalTitle">เพิ่มหมวดหมู่</h3>
          <button type="button" onclick="hide('headModal')" class="hic-iconbtn" aria-label="ปิด"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="headForm" method="POST" action="/admin/report-settings/heads" class="contents">
          {{ csrfField() }}
          <input type="hidden" name="id" id="head_id" />
          <div class="hic-modal-body">
            <div>
              <label class="hic-label" for="head_detail">ชื่อหมวดหมู่ <span class="hic-req">*</span></label>
              <input name="detail" id="head_detail" required class="hic-input" />
              <div class="hic-help">รองรับ HTML พื้นฐาน เช่น <code>&lt;font color=red&gt;</code></div>
            </div>
            <div>
              <label class="hic-label" for="head_sort">ลำดับ</label>
              <input type="number" name="sort" id="head_sort" value="1" min="1" class="hic-input" style="width:140px" />
            </div>
          </div>
          <div class="hic-modal-foot">
            <button type="button" onclick="hide('headModal')" class="hic-btn hic-btn-ghost">ยกเลิก</button>
            <button type="submit" class="hic-btn hic-btn-primary"><i class="fas fa-floppy-disk"></i>บันทึก</button>
          </div>
        </form>
      </div>
    </div>

    {{-- Report modal --}}
    <div id="reportModal" class="hic-modal hidden" role="dialog" aria-modal="true">
      <div class="hic-modal-box is-lg hic-tone-violet">
        <div class="hic-modal-head">
          <span class="hic-modal-icon"><i class="fas fa-file-lines"></i></span>
          <h3 id="reportModalTitle">เพิ่มรายงาน</h3>
          <button type="button" onclick="hide('reportModal')" class="hic-iconbtn" aria-label="ปิด"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="reportForm" method="POST" action="/admin/report-settings/reports" class="contents">
          {{ csrfField() }}
          <input type="hidden" name="id" id="report_id" />
          <div class="hic-modal-body">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="md:col-span-2">
                <label class="hic-label" for="report_detail">ชื่อรายงาน <span class="hic-req">*</span></label>
                <input name="detail" id="report_detail" required class="hic-input" />
              </div>
              <div>
                <label class="hic-label" for="report_head_id">หมวดหมู่ <span class="hic-req">*</span></label>
                <select name="head_id" id="report_head_id" required class="hic-input">
                  @each(h in heads)
                    <option value="{{ h.id }}">{{ stripTitleHtml(h.detail) }}</option>
                  @end
                </select>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label class="hic-label" for="report_db">ฐานข้อมูล <span class="hic-req">*</span></label>
                <select name="database_source" id="report_db" required class="hic-input">
                  <option value="system">ระบบ (system)</option>
                  <option value="his">HIS</option>
                </select>
              </div>
              <div>
                <label class="hic-label" for="report_sort">ลำดับ</label>
                <input type="number" name="sort" id="report_sort" value="1" min="1" class="hic-input" />
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1.5 gap-2">
                <label class="hic-label" for="report_sql1" style="margin:0">SQL หลัก <span class="hic-req">*</span></label>
                <button type="button" onclick="testSql()" id="testSqlBtn" class="hic-btn hic-btn-warn hic-btn-sm"><i class="fas fa-vial"></i>ทดสอบ SQL</button>
              </div>
              <textarea name="sql1" id="report_sql1" rows="9" required placeholder="SELECT … FROM … WHERE vstdate BETWEEN @start_d AND @end_d" class="hic-code" spellcheck="false"></textarea>
              <div class="hic-help">ใช้ token เช่น <code class="hic-mono">@start_d</code> <code class="hic-mono">@end_d</code> <code class="hic-mono">@main_dep</code> — อนุญาตเฉพาะคำสั่ง SELECT คำสั่งเดียว</div>
            </div>
            <details class="rounded-2xl" style="border:1px solid var(--border)">
              <summary class="px-4 py-3 text-sm cursor-pointer font-semibold" style="color:var(--ink)">SQL สำรอง (sql2) — ใช้สำหรับ count/aggregate <small style="color:var(--ink-muted);font-weight:400">(ไม่บังคับ)</small></summary>
              <div class="px-4 pb-4"><textarea name="sql2" id="report_sql2" rows="4" class="hic-code" style="min-height:110px" spellcheck="false"></textarea></div>
            </details>
            <div id="testResult" class="hidden"></div>
          </div>
          <div class="hic-modal-foot">
            <button type="button" onclick="hide('reportModal')" class="hic-btn hic-btn-ghost">ยกเลิก</button>
            <button type="submit" class="hic-btn hic-btn-primary"><i class="fas fa-floppy-disk"></i>บันทึก</button>
          </div>
        </form>
      </div>
    </div>

    {{-- Hidden delete forms --}}
    <form id="deleteHeadForm" method="POST" action="/admin/report-settings/heads/delete" class="hidden">
      {{ csrfField() }}
      <input type="hidden" name="id" id="deleteHeadId" />
    </form>
    <form id="deleteReportForm" method="POST" action="/admin/report-settings/reports/delete" class="hidden">
      {{ csrfField() }}
      <input type="hidden" name="id" id="deleteReportId" />
    </form>

    <script>
      function show(id) { const m = document.getElementById(id); m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden' }
      function hide(id) { const m = document.getElementById(id); m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = '' }
      function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])
      }

      function openHeadModal(h) {
        const f = document.getElementById('headForm')
        f.reset()
        if (h && h.id) {
          f.action = '/admin/report-settings/heads/update'
          document.getElementById('headModalTitle').textContent = 'แก้ไขหมวดหมู่'
          document.getElementById('head_id').value = h.id
          document.getElementById('head_detail').value = h.detail || ''
          document.getElementById('head_sort').value = h.sort || 1
        } else {
          f.action = '/admin/report-settings/heads'
          document.getElementById('headModalTitle').textContent = 'เพิ่มหมวดหมู่'
          document.getElementById('head_id').value = ''
          document.getElementById('head_sort').value = 1
        }
        show('headModal')
      }

      function openReportModal(r) {
        const f = document.getElementById('reportForm')
        f.reset()
        document.getElementById('testResult').classList.add('hidden')
        if (r && r.id) {
          f.action = '/admin/report-settings/reports/update'
          document.getElementById('reportModalTitle').textContent = 'แก้ไขรายงาน'
          document.getElementById('report_id').value = r.id
          document.getElementById('report_detail').value = r.detail || ''
          document.getElementById('report_head_id').value = String(r.head_id)
          document.getElementById('report_db').value = r.database_source || 'system'
          document.getElementById('report_sort').value = r.sort || 1
          document.getElementById('report_sql1').value = r.sql1 || ''
          document.getElementById('report_sql2').value = r.sql2 || ''
        } else {
          f.action = '/admin/report-settings/reports'
          document.getElementById('reportModalTitle').textContent = 'เพิ่มรายงาน'
          document.getElementById('report_id').value = ''
          document.getElementById('report_sort').value = 1
          if (r && r.head_id) document.getElementById('report_head_id').value = String(r.head_id)
        }
        show('reportModal')
      }

      function confirmDeleteHead(id, name) {
        if (!confirm('ยืนยันลบหมวดหมู่ "' + name + '"?')) return
        document.getElementById('deleteHeadId').value = id
        document.getElementById('deleteHeadForm').submit()
      }
      function confirmDeleteReport(id, name) {
        if (!confirm('ยืนยันลบรายงาน "' + name + '"?')) return
        document.getElementById('deleteReportId').value = id
        document.getElementById('deleteReportForm').submit()
      }

      async function testSql() {
        const sql = document.getElementById('report_sql1').value
        const src = document.getElementById('report_db').value
        const tr = document.getElementById('testResult')
        const btn = document.getElementById('testSqlBtn')
        const csrf = document.querySelector('#reportForm input[name="_csrf"]').value
        tr.className = 'hic-alert hic-alert-info'
        tr.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>กำลังทดสอบ…</span>'
        btn.disabled = true
        const fd = new FormData()
        fd.append('_csrf', csrf)
        fd.append('sql1', sql)
        fd.append('database_source', src)
        try {
          const res = await fetch('/admin/report-settings/test-sql', { method: 'POST', body: fd })
          const result = await res.json()
          if (result.success) {
            const cols = result.columns || []
            tr.className = 'hic-alert hic-alert-ok'
            tr.innerHTML = '<i class="fas fa-circle-check"></i><div><div class="font-bold">' + esc(result.message) + '</div>'
              + '<div class="text-xs mt-1">เวลา ' + esc(result.execution_time) + 's · คอลัมน์: ' + esc(cols.slice(0, 8).join(', ')) + (cols.length > 8 ? '…' : '') + '</div></div>'
          } else {
            tr.className = 'hic-alert hic-alert-bad'
            tr.innerHTML = '<i class="fas fa-circle-exclamation"></i><span class="break-all">' + esc(result.message) + '</span>'
          }
        } catch (e) {
          tr.className = 'hic-alert hic-alert-bad'
          tr.innerHTML = '<i class="fas fa-circle-exclamation"></i><span>' + esc(e.message || e) + '</span>'
        } finally {
          btn.disabled = false
        }
      }

      document.getElementById('headModal').addEventListener('click', e => { if (e.target.id === 'headModal') hide('headModal') })
      document.getElementById('reportModal').addEventListener('click', e => { if (e.target.id === 'reportModal') hide('reportModal') })
      document.addEventListener('keydown', e => { if (e.key === 'Escape') { hide('headModal'); hide('reportModal') } })

      // Category dropdown + search (one category at a time; search spans all)
      ;(function () {
        const grid = document.getElementById('rsGrid')
        const search = document.getElementById('rsSearch')
        if (!grid || !search) return
        const sections = Array.from(grid.querySelectorAll('.rp-sec'))
        const cats = Array.from(document.querySelectorAll('.rp-cat'))
        const catBtn = document.getElementById('catBtn')
        const catMenu = document.getElementById('catMenu')
        const catCurrent = document.getElementById('catCurrent')
        const catCurrentCount = document.getElementById('catCurrentCount')
        const catCurrentDot = document.getElementById('catCurrentDot')
        const noResults = document.getElementById('noResults')
        const hits = document.getElementById('hits')
        const hitCount = document.getElementById('hitCount')
        const STORE_CAT = 'hr-rs-cat'
        const store = {
          get(k) { try { return localStorage.getItem(k) } catch (e) { return null } },
          set(k, v) { try { localStorage.setItem(k, v) } catch (e) {} },
        }
        const sqlCache = new WeakMap()
        function sqlOf(row) {
          if (!sqlCache.has(row)) {
            let v = ''
            try { const r = JSON.parse(row.dataset.report); v = ((r.sql1 || '') + ' ' + (r.sql2 || '')).toLowerCase() } catch (e) {}
            sqlCache.set(row, v)
          }
          return sqlCache.get(row)
        }
        function highlight(el, q) {
          if (!el) return
          if (el.dataset.raw === undefined) el.dataset.raw = el.textContent
          const raw = el.dataset.raw
          const at = q ? raw.toLowerCase().indexOf(q) : -1
          if (at < 0) { if (el.dataset.marked) { el.textContent = raw; delete el.dataset.marked } return }
          el.innerHTML = esc(raw.slice(0, at)) + '<mark>' + esc(raw.slice(at, at + q.length)) + '</mark>' + esc(raw.slice(at + q.length))
          el.dataset.marked = '1'
        }

        let current = store.get(STORE_CAT)
        const editRow = document.getElementById('report-row-' + new URLSearchParams(location.search).get('edit'))
        if (editRow) current = editRow.closest('.rp-sec').dataset.cat
        if (!current || !cats.some(c => c.dataset.cat === current)) current = sections[0]?.dataset.cat || 'all'

        function render() {
          const q = search.value.trim().toLowerCase()
          let total = 0
          sections.forEach(sec => {
            const catMatch = q && (sec.dataset.category || '').includes(q)
            let shown = 0
            sec.querySelectorAll('.rs-row').forEach(row => {
              const ok = !q || catMatch || (row.dataset.name || '').includes(q) || sqlOf(row).includes(q)
              row.style.display = ok ? '' : 'none'
              if (ok) shown++
              highlight(row.querySelector('.rs-title'), ok ? q : '')
            })
            total += shown
            sec.querySelector('.rp-sec-count').textContent = shown
            const navBtn = cats.find(c => c.dataset.cat === sec.dataset.cat)
            if (navBtn) {
              const countEl = navBtn.querySelector('.rp-cat-count')
              countEl.textContent = q ? shown : countEl.dataset.total
              navBtn.classList.toggle('is-empty', !!q && shown === 0)
            }
            sec.style.display = (q ? shown > 0 : (current === 'all' || sec.dataset.cat === current)) ? '' : 'none'
          })
          const allBtn = cats.find(c => c.dataset.cat === 'all')
          if (allBtn) { const c = allBtn.querySelector('.rp-cat-count'); c.textContent = q ? total : c.dataset.total }

          cats.forEach(c => c.classList.toggle('is-active', q ? c.dataset.cat === 'all' : c.dataset.cat === current))
          const activeBtn = cats.find(c => c.classList.contains('is-active'))
          if (activeBtn) {
            catCurrent.textContent = q ? 'ผลค้นหาทุกหมวด' : activeBtn.title
            catCurrentCount.textContent = activeBtn.querySelector('.rp-cat-count').textContent
            catCurrentDot.style.background = getComputedStyle(activeBtn.querySelector('.rp-cat-dot')).backgroundColor
          }
          noResults.classList.toggle('hidden', !q || total > 0)
          hits.classList.toggle('hidden', !q)
          hitCount.textContent = total
        }

        function openMenu(on) {
          catMenu.hidden = !on
          catBtn.setAttribute('aria-expanded', String(on))
          if (on) (catMenu.querySelector('.rp-cat.is-active') || cats[0])?.focus()
        }
        catBtn.addEventListener('click', () => openMenu(catMenu.hidden))
        document.addEventListener('click', e => { if (!catMenu.hidden && !e.target.closest('#catDD')) openMenu(false) })
        catMenu.addEventListener('keydown', e => {
          const i = cats.indexOf(document.activeElement)
          if (e.key === 'Escape') { openMenu(false); catBtn.focus() }
          else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault()
            cats[(i + (e.key === 'ArrowDown' ? 1 : cats.length - 1)) % cats.length]?.focus()
          }
        })
        cats.forEach(btn => btn.addEventListener('click', () => {
          openMenu(false)
          if (search.value.trim()) {
            const sec = sections.find(s => s.dataset.cat === btn.dataset.cat)
            if (sec && sec.style.display !== 'none') sec.scrollIntoView({ behavior: 'smooth', block: 'start' })
            return
          }
          current = btn.dataset.cat
          store.set(STORE_CAT, current)
          render()
        }))

        let timer = null
        search.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(render, 100) })
        render()
      })()

      // Auto-open the edit modal when arriving via /admin/report-settings?edit=<id>
      ;(function () {
        const params = new URLSearchParams(window.location.search)
        const editId = params.get('edit')
        if (!editId) return
        const row = document.getElementById('report-row-' + editId)
        const btn = document.querySelector('[data-edit-report="' + editId + '"]')
        if (row) {
          // instant scroll — smooth scroll gets aborted when the modal sets body.overflow=hidden
          row.scrollIntoView({ block: 'center' })
          row.classList.add('is-flash')
          setTimeout(() => { row.classList.remove('is-flash') }, 2500)
        }
        if (btn) btn.click()
        // strip ?edit from the URL so that form-submit redirect().back() doesn't re-open the modal
        const url = new URL(window.location.href)
        url.searchParams.delete('edit')
        history.replaceState(null, '', url.toString())
      })()
    </script>
  @end
@end
