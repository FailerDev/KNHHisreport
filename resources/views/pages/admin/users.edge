@component('layouts/app', {
  title: 'จัดการผู้ใช้ · HisReport',
  showSidebar: true,
  isAdmin: true,
  fullname: auth?.user?.fullname || auth?.user?.username,
  department: auth?.user?.department,
  currentPage: '',
})
  @slot('main')
    <div class="max-w-7xl mx-auto">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold text-gray-800 flex items-center gap-2">
          <i class="fas fa-users-gear text-primary"></i> จัดการผู้ใช้
        </h1>
        <p class="text-sm text-gray-500 mt-1">เพิ่ม แก้ไข และจัดการสิทธิ์การเข้าถึงระบบ</p>
      </header>

      @if(message)
        <div class="mb-4 px-4 py-3 rounded-lg border text-sm flex items-center gap-2 {{ messageType === 'success' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' }}">
          <i class="fas {{ messageType === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' }}"></i>
          <span>{{ message }}</span>
        </div>
      @end

      {{-- Stats --}}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <div class="bg-white rounded-xl p-4 border border-gray-200 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center"><i class="fas fa-users"></i></div>
          <div><div class="text-xs text-gray-500">ผู้ใช้ทั้งหมด</div><div class="text-xl font-semibold">{{ stats.total }}</div></div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-gray-200 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-success/10 text-success flex items-center justify-center"><i class="fas fa-circle-check"></i></div>
          <div><div class="text-xs text-gray-500">ใช้งานอยู่</div><div class="text-xl font-semibold">{{ stats.active }}</div></div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-gray-200 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center"><i class="fas fa-user-shield"></i></div>
          <div><div class="text-xs text-gray-500">ผู้ดูแลระบบ</div><div class="text-xl font-semibold">{{ stats.admins }}</div></div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-gray-200 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-danger/10 text-danger flex items-center justify-center"><i class="fas fa-user-slash"></i></div>
          <div><div class="text-xs text-gray-500">ปิดใช้งาน</div><div class="text-xl font-semibold">{{ stats.inactive }}</div></div>
        </div>
      </div>

      {{-- Users table --}}
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200 flex flex-wrap items-center gap-3 justify-between">
          <div class="flex items-center gap-2">
            <h2 class="text-base font-semibold text-gray-800">รายชื่อผู้ใช้</h2>
            <span class="text-xs px-2 py-0.5 rounded bg-gray-100 text-gray-600">{{ stats.total }} คน</span>
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center text-gray-400"><i class="fas fa-magnifying-glass text-xs"></i></span>
              <input id="userSearch" type="text" placeholder="ค้นหาผู้ใช้..."
                class="pl-8 pr-3 py-1.5 text-sm rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none w-64" />
            </div>
            <select id="userLevelFilter" class="px-2 py-1.5 text-sm rounded-md border border-gray-300 focus:ring-2 focus:ring-primary outline-none">
              <option value="">ทุกสิทธิ์</option>
              <option value="admin">ผู้ดูแลระบบ</option>
              <option value="user">ผู้ใช้ทั่วไป</option>
            </select>
            <button type="button" onclick="openAddModal()"
              class="px-3 py-1.5 rounded-md bg-primary hover:bg-primary/90 text-white text-sm flex items-center gap-1.5">
              <i class="fas fa-plus text-xs"></i>เพิ่มผู้ใช้
            </button>
          </div>
        </div>

        @if(users.length === 0)
          <div class="py-16 text-center text-gray-500">
            <div class="w-14 h-14 rounded-full bg-gray-100 mx-auto flex items-center justify-center text-gray-400 text-2xl mb-3"><i class="fas fa-users-slash"></i></div>
            <div class="text-sm">ยังไม่มีผู้ใช้ในระบบ</div>
          </div>
        @else
          <div class="overflow-x-auto">
            <table class="w-full text-sm" id="usersTable">
              <thead class="bg-gray-50 text-gray-600 text-xs uppercase">
                <tr>
                  <th class="text-left px-4 py-2">ผู้ใช้</th>
                  <th class="text-left px-4 py-2">อีเมล</th>
                  <th class="text-left px-4 py-2">แผนก</th>
                  <th class="text-left px-4 py-2">สิทธิ์</th>
                  <th class="text-left px-4 py-2">สถานะ</th>
                  <th class="text-left px-4 py-2">เข้าระบบล่าสุด</th>
                  <th class="text-right px-4 py-2">จัดการ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                @each(u in users)
                  @let(rowIsAdmin = u.userLevel === 'admin')
                  @let(rowIsActive = u.status === 1)
                  @let(rowInitial = (u.fullname || u.username || '?').substring(0, 1).toUpperCase())
                  <tr
                    data-search="{{ ((u.username || '') + ' ' + (u.fullname || '') + ' ' + (u.email || '') + ' ' + (u.department || '')).toLowerCase() }}"
                    data-level="{{ rowIsAdmin ? 'admin' : 'user' }}"
                  >
                    <td class="px-4 py-2.5">
                      <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs font-semibold">{{ rowInitial }}</div>
                        <div>
                          <div class="font-medium text-gray-800">{{ u.fullname || '—' }}</div>
                          <div class="text-xs text-gray-500">{{ '@' + u.username }}</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-2.5 text-gray-700">{{ u.email || '—' }}</td>
                    <td class="px-4 py-2.5 text-gray-700">{{ u.department || '—' }}</td>
                    <td class="px-4 py-2.5">
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs {{ rowIsAdmin ? 'bg-warning/15 text-warning' : 'bg-primary/15 text-primary' }}">
                        <i class="fas fa-{{ rowIsAdmin ? 'crown' : 'user' }}" style="font-size:0.625rem;"></i>
                        {{ rowIsAdmin ? 'ผู้ดูแล' : 'ผู้ใช้' }}
                      </span>
                    </td>
                    <td class="px-4 py-2.5">
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs {{ rowIsActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' }}">
                        <span class="w-1.5 h-1.5 rounded-full {{ rowIsActive ? 'bg-green-500' : 'bg-gray-400' }}"></span>
                        {{ rowIsActive ? 'ใช้งาน' : 'ปิดใช้งาน' }}
                      </span>
                    </td>
                    <td class="px-4 py-2.5 text-xs text-gray-500">
                      {{ u.lastLogin ? u.lastLogin.toFormat('dd/MM/yyyy HH:mm') : '—' }}
                    </td>
                    <td class="px-4 py-2.5">
                      <div class="flex justify-end gap-1">
                        <button type="button" title="แก้ไข"
                          onclick="openEditModal({{ JSON.stringify({ id: u.id, username: u.username, fullname: u.fullname, email: u.email, department: u.department, user_level: u.userLevel, status: u.status }) }})"
                          class="w-8 h-8 rounded hover:bg-gray-100 text-gray-600">
                          <i class="fas fa-pen text-sm"></i>
                        </button>
                        <button type="button" title="รีเซ็ตรหัสผ่าน"
                          onclick="openResetModal({{ u.id }}, '{{ u.username }}')"
                          class="w-8 h-8 rounded hover:bg-gray-100 text-warning">
                          <i class="fas fa-key text-sm"></i>
                        </button>
                        @if(u.id !== auth.user.id)
                          <button type="button" title="ลบ"
                            onclick="confirmDelete({{ u.id }}, '{{ u.username }}')"
                            class="w-8 h-8 rounded hover:bg-gray-100 text-danger">
                            <i class="fas fa-trash text-sm"></i>
                          </button>
                        @end
                      </div>
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
          <div id="emptyResult" class="py-12 text-center text-gray-500 hidden">
            <i class="fas fa-magnifying-glass text-2xl mb-2 text-gray-300"></i>
            <div class="text-sm">ไม่พบผู้ใช้ตรงตามเงื่อนไข</div>
          </div>
        @end
      </div>
    </div>

    {{-- Add / Edit modal --}}
    <div id="userModal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl">
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
            <i id="userModalIcon" class="fas fa-user-plus text-primary"></i>
            <span id="userModalTitle">เพิ่มผู้ใช้ใหม่</span>
          </h3>
          <button type="button" onclick="closeUserModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="userForm" method="POST" action="/admin/users">
          {{ csrfField() }}
          <input type="hidden" name="_method" id="userMethod" value="">
          <div class="p-5 space-y-4">
            <input type="hidden" name="user_id" id="userId" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div id="usernameGroup">
                <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อผู้ใช้ <span class="text-red-500">*</span></label>
                <input type="text" name="username" id="username" required
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
              </div>
              <div id="passwordGroup">
                <label class="block text-sm font-medium text-gray-700 mb-1">รหัสผ่าน <span class="text-red-500">*</span></label>
                <input type="password" name="password" id="password" required minlength="6"
                  placeholder="อย่างน้อย 6 ตัวอักษร"
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">ชื่อ-นามสกุล <span class="text-red-500">*</span></label>
              <input type="text" name="fullname" id="fullname" required
                class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">อีเมล</label>
                <input type="email" name="email" id="email"
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">แผนก</label>
                <input type="text" name="department" id="department"
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">สิทธิ์ <span class="text-red-500">*</span></label>
                <select name="user_level" id="user_level" required
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none bg-white">
                  <option value="user">ผู้ใช้ทั่วไป</option>
                  <option value="admin">ผู้ดูแลระบบ</option>
                </select>
              </div>
              <div id="statusGroup" class="hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1">สถานะ <span class="text-red-500">*</span></label>
                <select name="status" id="status"
                  class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none bg-white">
                  <option value="1">ใช้งาน</option>
                  <option value="0">ปิดใช้งาน</option>
                </select>
              </div>
            </div>
          </div>
          <div class="px-5 py-3 border-t border-gray-200 flex justify-end gap-2 bg-gray-50">
            <button type="button" onclick="closeUserModal()" class="px-3 py-2 rounded-md text-sm border border-gray-300 hover:bg-gray-100">ยกเลิก</button>
            <button type="submit" class="px-3 py-2 rounded-md text-sm bg-primary text-white hover:bg-primary/90 flex items-center gap-1.5">
              <i class="fas fa-save text-xs"></i>บันทึก
            </button>
          </div>
        </form>
      </div>
    </div>

    {{-- Reset password modal --}}
    <div id="resetModal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
      <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
        <div class="flex items-center justify-between p-4 border-b border-gray-200">
          <h3 class="text-base font-semibold text-gray-800 flex items-center gap-2">
            <i class="fas fa-key text-warning"></i>รีเซ็ตรหัสผ่าน
          </h3>
          <button type="button" onclick="closeResetModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-xmark"></i></button>
        </div>
        <form method="POST" action="/admin/users/reset-password">
          {{ csrfField() }}
          <div class="p-5 space-y-4">
            <input type="hidden" name="user_id" id="resetUserId" />
            <div class="px-3 py-2 rounded-md bg-blue-50 border border-blue-200 text-blue-700 text-sm flex items-center gap-2">
              <i class="fas fa-circle-info"></i>
              <span>กำลังรีเซ็ตรหัสผ่านของ <b id="resetUsername"></b></span>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">รหัสผ่านใหม่ <span class="text-red-500">*</span></label>
              <input type="password" name="new_password" required minlength="6"
                class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">ยืนยันรหัสผ่านใหม่ <span class="text-red-500">*</span></label>
              <input type="password" name="confirm_password" required minlength="6"
                class="w-full px-3 py-2 rounded-md border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
            </div>
          </div>
          <div class="px-5 py-3 border-t border-gray-200 flex justify-end gap-2 bg-gray-50">
            <button type="button" onclick="closeResetModal()" class="px-3 py-2 rounded-md text-sm border border-gray-300 hover:bg-gray-100">ยกเลิก</button>
            <button type="submit" class="px-3 py-2 rounded-md text-sm bg-warning text-white hover:bg-warning/90 flex items-center gap-1.5">
              <i class="fas fa-rotate text-xs"></i>รีเซ็ต
            </button>
          </div>
        </form>
      </div>
    </div>

    {{-- Hidden delete form --}}
    <form id="deleteForm" method="POST" action="/admin/users/delete" class="hidden">
      {{ csrfField() }}
      <input type="hidden" name="user_id" id="deleteUserId" />
    </form>

    <script>
      function showModal(id) { const m = document.getElementById(id); m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden' }
      function hideModal(id) { const m = document.getElementById(id); m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = '' }

      function openAddModal() {
        document.getElementById('userForm').action = '/admin/users'
        document.getElementById('userForm').reset()
        document.getElementById('userModalTitle').textContent = 'เพิ่มผู้ใช้ใหม่'
        document.getElementById('usernameGroup').classList.remove('hidden')
        document.getElementById('passwordGroup').classList.remove('hidden')
        document.getElementById('username').required = true
        document.getElementById('password').required = true
        document.getElementById('statusGroup').classList.add('hidden')
        document.getElementById('userId').value = ''
        showModal('userModal')
      }

      function openEditModal(user) {
        document.getElementById('userForm').action = '/admin/users/update'
        document.getElementById('userModalTitle').textContent = 'แก้ไขข้อมูลผู้ใช้'
        document.getElementById('userId').value = user.id
        document.getElementById('username').value = user.username || ''
        document.getElementById('fullname').value = user.fullname || ''
        document.getElementById('email').value = user.email || ''
        document.getElementById('department').value = user.department || ''
        document.getElementById('user_level').value = user.user_level || 'user'
        document.getElementById('status').value = String(user.status ?? 1)
        document.getElementById('usernameGroup').classList.add('hidden')
        document.getElementById('passwordGroup').classList.add('hidden')
        document.getElementById('username').required = false
        document.getElementById('password').required = false
        document.getElementById('statusGroup').classList.remove('hidden')
        showModal('userModal')
      }

      function closeUserModal() { hideModal('userModal') }

      function openResetModal(userId, username) {
        document.querySelector('#resetModal form').reset()
        document.getElementById('resetUserId').value = userId
        document.getElementById('resetUsername').textContent = username
        showModal('resetModal')
      }
      function closeResetModal() { hideModal('resetModal') }

      function confirmDelete(userId, username) {
        if (!confirm('ยืนยันลบผู้ใช้ "' + username + '"? การดำเนินการนี้ไม่สามารถย้อนกลับได้')) return
        document.getElementById('deleteUserId').value = userId
        document.getElementById('deleteForm').submit()
      }

      // Close modal on backdrop click
      document.getElementById('userModal').addEventListener('click', e => {
        if (e.target.id === 'userModal') closeUserModal()
      })
      document.getElementById('resetModal').addEventListener('click', e => {
        if (e.target.id === 'resetModal') closeResetModal()
      })

      // Search + filter
      const search = document.getElementById('userSearch')
      const filter = document.getElementById('userLevelFilter')
      const empty = document.getElementById('emptyResult')
      function applyFilter() {
        const q = (search?.value || '').trim().toLowerCase()
        const lvl = filter?.value || ''
        let visible = 0
        document.querySelectorAll('#usersTable tbody tr').forEach(tr => {
          const ok = (!q || tr.dataset.search.includes(q)) && (!lvl || tr.dataset.level === lvl)
          tr.style.display = ok ? '' : 'none'
          if (ok) visible++
        })
        if (empty) empty.classList.toggle('hidden', visible > 0)
      }
      search?.addEventListener('input', applyFilter)
      filter?.addEventListener('change', applyFilter)
    </script>
  @end
@end
