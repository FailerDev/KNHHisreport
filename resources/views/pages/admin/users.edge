      {{-- Users table --}}
      <div class="hic-panel overflow-hidden">
        <div class="hic-panel-head">
          <h2><i class="fas fa-address-book" style="color:var(--heading)"></i>รายชื่อผู้ใช้ <span class="hic-pill">{{ stats.total }} คน</span></h2>
          <div class="hic-toolbar">
            <label class="hic-search" style="width:260px">
              <i class="fas fa-magnifying-glass" style="font-size:13px"></i>
              <input id="userSearch" type="text" placeholder="ค้นหาชื่อ แผนก อีเมล…" style="font-size:14px" />
            </label>
            <select id="userLevelFilter" class="hic-input" style="border-radius:9999px;font-size:14px">
              <option value="">ทุกสิทธิ์</option>
              <option value="admin">ผู้ดูแลระบบ</option>
              <option value="user">ผู้ใช้ทั่วไป</option>
            </select>
          </div>
        </div>

        @if(users.length === 0)
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-users-slash"></i></span>
            <b>ยังไม่มีผู้ใช้ในระบบ</b>
            <button type="button" onclick="openAddModal()" class="hic-btn hic-btn-secondary hic-btn-sm mt-3"><i class="fas fa-plus"></i>เพิ่มผู้ใช้คนแรก</button>
          </div>
        @else
          <div class="hic-table-wrap" style="max-height:none">
            <table class="hic-table" id="usersTable">
              <thead>
                <tr>
                  <th>ผู้ใช้</th>
                  <th>อีเมล</th>
                  <th>แผนก</th>
                  <th>สิทธิ์</th>
                  <th>สถานะ</th>
                  <th>เข้าระบบล่าสุด</th>
                  <th style="text-align:right">จัดการ</th>
                </tr>
              </thead>
              <tbody>
                @each(u in users)
                  @let(rowIsAdmin = u.userLevel === 'admin')
                  @let(rowIsActive = u.status === 1)
                  @let(rowInitial = (u.fullname || u.username || '?').substring(0, 2))
                  <tr
                    data-search="{{ ((u.username || '') + ' ' + (u.fullname || '') + ' ' + (u.email || '') + ' ' + (u.department || '')).toLowerCase() }}"
                    data-level="{{ rowIsAdmin ? 'admin' : 'user' }}"
                  >
                    <td>
                      <div class="flex items-center gap-3">
                        <span class="hic-avatar-sm" style="{{ rowIsActive ? '' : 'filter:grayscale(1);opacity:.6' }}">{{ rowInitial }}</span>
                        <div>
                          <div class="font-semibold" style="color:var(--ink-strong)">{{ u.fullname || '—' }}</div>
                          <div class="hic-mono" style="color:var(--ink-subtle)">{{ '@' + u.username }}</div>
                        </div>
                      </div>
                    </td>
                    <td>{{ u.email || '—' }}</td>
                    <td>{{ u.department || '—' }}</td>
                    <td>
                      <span class="hic-badge {{ rowIsAdmin ? 'hic-badge-warn' : 'hic-badge-brand' }}">
                        <i class="fas fa-{{ rowIsAdmin ? 'crown' : 'user' }}"></i>{{ rowIsAdmin ? 'ผู้ดูแล' : 'ผู้ใช้' }}
                      </span>
                    </td>
                    <td>
                      <span class="hic-badge {{ rowIsActive ? 'hic-badge-ok' : 'hic-badge-muted' }}">
                        <span class="hic-dot"></span>{{ rowIsActive ? 'ใช้งาน' : 'ปิดใช้งาน' }}
                      </span>
                    </td>
                    <td style="color:var(--ink-subtle);font-size:13px;white-space:nowrap">
                      {{ u.lastLogin ? u.lastLogin.toFormat('dd/MM/yyyy HH:mm') : '—' }}
                    </td>
                    <td>
                      <div class="flex justify-end gap-1">
                        <button type="button" title="แก้ไข" class="hic-act is-brand"
                          onclick="openEditModal({{ JSON.stringify({ id: u.id, username: u.username, fullname: u.fullname, email: u.email, department: u.department, user_level: u.userLevel, status: u.status }) }})">
                          <i class="fas fa-pen"></i>
                        </button>
                        <button type="button" title="รีเซ็ตรหัสผ่าน" class="hic-act is-warn"
                          onclick="openResetModal({{ u.id }}, '{{ u.username }}')">
                          <i class="fas fa-key"></i>
                        </button>
                        @if(u.id !== auth.user.id)
                          <button type="button" title="ลบ" class="hic-act is-bad"
                            onclick="confirmDelete({{ u.id }}, '{{ u.username }}')">
                            <i class="fas fa-trash"></i>
                          </button>
                        @end
                      </div>
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
          <div id="emptyResult" class="hic-empty hidden">
            <span class="hic-empty-icon"><i class="fas fa-magnifying-glass"></i></span>
            <b>ไม่พบผู้ใช้ตรงตามเงื่อนไข</b>
          </div>
        @end
      </div>
    </div>

    {{-- Add / Edit modal --}}
    <div id="userModal" class="hic-modal hidden" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
      <div class="hic-modal-box hic-tone-blue">
        <div class="hic-modal-head">
          <span class="hic-modal-icon"><i id="userModalIcon" class="fas fa-user-plus"></i></span>
          <h3 id="userModalTitle">เพิ่มผู้ใช้ใหม่</h3>
          <button type="button" onclick="closeUserModal()" class="hic-iconbtn" aria-label="ปิด"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="userForm" method="POST" action="/admin/users" class="contents">
          {{ csrfField() }}
          <input type="hidden" name="_method" id="userMethod" value="">
          <input type="hidden" name="user_id" id="userId" />
          <div class="hic-modal-body">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div id="usernameGroup">
                <label class="hic-label" for="username">ชื่อผู้ใช้ <span class="hic-req">*</span></label>
                <input type="text" name="username" id="username" required class="hic-input" autocomplete="off" />
              </div>
              <div id="passwordGroup">
                <label class="hic-label" for="password">รหัสผ่าน <span class="hic-req">*</span></label>
                <input type="password" name="password" id="password" required minlength="6" placeholder="อย่างน้อย 6 ตัวอักษร" class="hic-input" autocomplete="new-password" />
              </div>
            </div>
            <div>
              <label class="hic-label" for="fullname">ชื่อ-นามสกุล <span class="hic-req">*</span></label>
              <input type="text" name="fullname" id="fullname" required class="hic-input" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="hic-label" for="email">อีเมล</label>
                <input type="email" name="email" id="email" class="hic-input" />
              </div>
              <div>
                <label class="hic-label" for="department">แผนก</label>
                <input type="text" name="department" id="department" class="hic-input" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="hic-label" for="user_level">สิทธิ์ <span class="hic-req">*</span></label>
                <select name="user_level" id="user_level" required class="hic-input">
                  <option value="user">ผู้ใช้ทั่วไป</option>
                  <option value="admin">ผู้ดูแลระบบ</option>
                </select>
              </div>
              <div id="statusGroup" class="hidden">
                <label class="hic-label" for="status">สถานะ <span class="hic-req">*</span></label>
                <select name="status" id="status" class="hic-input">
                  <option value="1">ใช้งาน</option>
                  <option value="0">ปิดใช้งาน</option>
                </select>
              </div>
            </div>
          </div>
          <div class="hic-modal-foot">
            <button type="button" onclick="closeUserModal()" class="hic-btn hic-btn-ghost">ยกเลิก</button>
            <button type="submit" class="hic-btn hic-btn-primary"><i class="fas fa-floppy-disk"></i>บันทึก</button>
          </div>
        </form>
      </div>
    </div>

    {{-- Reset password modal --}}
    <div id="resetModal" class="hic-modal hidden" role="dialog" aria-modal="true">
      <div class="hic-modal-box is-sm hic-tone-yellow">
        <div class="hic-modal-head">
          <span class="hic-modal-icon"><i class="fas fa-key"></i></span>
          <h3>รีเซ็ตรหัสผ่าน</h3>
          <button type="button" onclick="closeResetModal()" class="hic-iconbtn" aria-label="ปิด"><i class="fas fa-xmark"></i></button>
        </div>
        <form method="POST" action="/admin/users/reset-password" class="contents">
          {{ csrfField() }}
          <input type="hidden" name="user_id" id="resetUserId" />
          <div class="hic-modal-body">
            <div class="hic-alert hic-alert-info">
              <i class="fas fa-circle-info"></i>
              <span>กำลังรีเซ็ตรหัสผ่านของ <b id="resetUsername"></b></span>
            </div>
            <div>
              <label class="hic-label">รหัสผ่านใหม่ <span class="hic-req">*</span></label>
              <input type="password" name="new_password" required minlength="6" class="hic-input" autocomplete="new-password" />
            </div>
            <div>
              <label class="hic-label">ยืนยันรหัสผ่านใหม่ <span class="hic-req">*</span></label>
              <input type="password" name="confirm_password" required minlength="6" class="hic-input" autocomplete="new-password" />
            </div>
          </div>
          <div class="hic-modal-foot">
            <button type="button" onclick="closeResetModal()" class="hic-btn hic-btn-ghost">ยกเลิก</button>
            <button type="submit" class="hic-btn hic-btn-primary"><i class="fas fa-rotate"></i>รีเซ็ต</button>
          </div>
        </form>
      </div>
    </div>

    {{-- Hidden delete form --}}
    <form id="deleteForm" method="POST" action="/admin/users/delete" class="hidden">
      {{ csrfField() }}
      <input type="hidden" name="user_id" id="deleteUserId" />
    </form>

    <script>
      function showModal(id) { const m = document.getElementById(id); m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden' }
      function hideModal(id) { const m = document.getElementById(id); m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = '' }

      function openAddModal() {
        document.getElementById('userForm').action = '/admin/users'
        document.getElementById('userForm').reset()
        document.getElementById('userModalTitle').textContent = 'เพิ่มผู้ใช้ใหม่'
        document.getElementById('userModalIcon').className = 'fas fa-user-plus'
        document.getElementById('usernameGroup').classList.remove('hidden')
        document.getElementById('passwordGroup').classList.remove('hidden')
        document.getElementById('username').required = true
        document.getElementById('password').required = true
        document.getElementById('statusGroup').classList.add('hidden')
        document.getElementById('userId').value = ''
        showModal('userModal')
        setTimeout(() => document.getElementById('username').focus(), 50)
      }

      function openEditModal(user) {
        document.getElementById('userForm').action = '/admin/users/update'
        document.getElementById('userModalTitle').textContent = 'แก้ไขข้อมูลผู้ใช้'
        document.getElementById('userModalIcon').className = 'fas fa-user-pen'
        document.getElementById('userId').value = user.id
        document.getElementById('username').value = user.username || ''
        document.getElementById('fullname').value = user.fullname || ''
        document.getElementById('email').value = user.email || ''
        document.getElementById('department').value = user.department || ''
        document.getElementById('user_level').value = user.user_level || 'user'
        document.getElementById('status').value = String(user.status ?? 1)
        document.getElementById('usernameGroup').classList.add('hidden')
        document.getElementById('passwordGroup').classList.add('hidden')
        document.getElementById('username').required = false
        document.getElementById('password').required = false
        document.getElementById('statusGroup').classList.remove('hidden')
        showModal('userModal')
      }

      function closeUserModal() { hideModal('userModal') }

      function openResetModal(userId, username) {
        document.querySelector('#resetModal form').reset()
        document.getElementById('resetUserId').value = userId
        document.getElementById('resetUsername').textContent = username
        showModal('resetModal')
      }
      function closeResetModal() { hideModal('resetModal') }

      function confirmDelete(userId, username) {
        if (!confirm('ยืนยันลบผู้ใช้ "' + username + '"? การดำเนินการนี้ไม่สามารถย้อนกลับได้')) return
        document.getElementById('deleteUserId').value = userId
        document.getElementById('deleteForm').submit()
      }

      // Close modal on backdrop click / Escape
      document.getElementById('userModal').addEventListener('click', e => {
        if (e.target.id === 'userModal') closeUserModal()
      })
      document.getElementById('resetModal').addEventListener('click', e => {
        if (e.target.id === 'resetModal') closeResetModal()
      })
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { closeUserModal(); closeResetModal() }
      })

      // Search + filter
      const search = document.getElementById('userSearch')
      const filter = document.getElementById('userLevelFilter')
      const empty = document.getElementById('emptyResult')
      function applyFilter() {
        const q = (search?.value || '').trim().toLowerCase()
        const lvl = filter?.value || ''
        let visible = 0
        document.querySelectorAll('#usersTable tbody tr').forEach(tr => {
          const ok = (!q || tr.dataset.search.includes(q)) && (!lvl || tr.dataset.level === lvl)
          tr.style.display = ok ? '' : 'none'
          if (ok) visible++
        })
        if (empty) empty.classList.toggle('hidden', visible > 0)
      }
      search?.addEventListener('input', applyFilter)
      filter?.addEventListener('change', applyFilter)
    </script>
  @end
@end
