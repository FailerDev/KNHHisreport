        </div>
        <div class="hic-metric hic-tone-green hic-rise" style="--i:1">
          <span class="hic-metric-icon"><i class="fas fa-circle-check"></i></span>
          <div><div class="hic-metric-label">ใช้งานอยู่</div><div class="hic-metric-value">{{ stats.active }}</div></div>
        </div>
