  @slot('scripts')
    <script>
      function show(id) { const m = document.getElementById(id); m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden' }
      function hide(id) { const m = document.getElementById(id); m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = '' }

      (function () {
        const select = document.getElementById('report_id')
        const box = document.getElementById('paramFields')
        if (!select || !box) return
        // Request's date range seeds the first two date inputs (start, end).
        const requestDates = [{{{ JSON.stringify(req.dateFrom ? req.dateFrom.toISODate() : '') }}}, {{{ JSON.stringify(req.dateTo ? req.dateTo.toISODate() : '') }}}]

        function field(f, dateIdx) {
          const wrap = document.createElement('div')
          const label = document.createElement('label')
          label.className = 'hic-label'
          label.textContent = f.label + (f.required ? ' *' : '')
          wrap.appendChild(label)

          let input
          if (f.type === 'select') {
            input = document.createElement('select')
            const empty = document.createElement('option')
            empty.value = ''
            empty.textContent = '-- เลือก --'
            input.appendChild(empty)
            for (const o of f.options) {
              const opt = document.createElement('option')
              opt.value = o
              opt.textContent = o
              input.appendChild(opt)
            }
          } else if (f.type === 'textarea') {
            input = document.createElement('textarea')
          } else {
            input = document.createElement('input')
            input.type = f.type === 'datetime' ? 'datetime-local' : (['date', 'number'].includes(f.type) ? f.type : 'text')
          }
          input.name = f.name
          input.className = 'hic-input'
          input.required = !!f.required
          let value = f.default || ''
          if (f.type === 'date' && !value && requestDates[dateIdx]) value = requestDates[dateIdx]
          input.value = value
          wrap.appendChild(input)
          return wrap
        }

        // Realtime search: rebuild the list from the full option set on every
        // keystroke. Every whitespace-separated word must match; the currently
        // selected report always stays in the list so its params aren't lost.
        const search = document.getElementById('report_search')
        const hits = document.getElementById('report_hits')
        const none = document.getElementById('report_none')
        const all = Array.from(select.options).map((o) => ({ value: o.value, text: o.text, key: o.text.toLowerCase() }))

        function filterReports() {
          const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean)
          const current = select.value
          const matched = all.filter((o) => o.value === current || words.every((w) => o.key.includes(w)))
          select.replaceChildren(...matched.map((o) => new Option(o.text, o.value, false, o.value === current)))
          const count = matched.filter((o) => o.value !== current || words.every((w) => o.key.includes(w))).length
          hits.textContent = count + ' รายการ'
          none.classList.toggle('hidden', count > 0)
        }

        search.addEventListener('input', filterReports)
        search.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault()
            select.focus()
            if (select.selectedIndex < 0 && select.options.length) select.selectedIndex = 0
          } else if (e.key === 'Enter') {
            // Enter picks the first match instead of submitting the form
            e.preventDefault()
            if (select.options.length) {
              select.selectedIndex = 0
              select.dispatchEvent(new Event('change'))
            }
          }
        })

        select.addEventListener('change', async () => {
          box.replaceChildren()
          if (!select.value) return
          try {
            const res = await fetch('/admin/requests/report-params/' + encodeURIComponent(select.value), { headers: { Accept: 'application/json' } })
            const data = await res.json()
            let dateIdx = 0
            for (const f of data.fields || []) {
              box.appendChild(field(f, dateIdx))
              if (f.type === 'date') dateIdx++
            }
            if (!data.fields || data.fields.length === 0) {
              const p = document.createElement('div')
              p.className = 'hic-help'
              p.textContent = 'รายงานนี้ไม่ต้องกรอกพารามิเตอร์'
              box.appendChild(p)
            }
          } catch (e) {
            box.textContent = 'โหลดพารามิเตอร์ไม่สำเร็จ'
          }
        })
      })()
    </script>
  @end
@end
