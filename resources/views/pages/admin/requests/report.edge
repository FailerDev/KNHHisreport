          <a href="/admin/requests/report" class="hic-btn hic-btn-ghost">ปีงบประมาณนี้</a>
          @if(rangeError)
            <span class="hic-badge hic-badge-bad"><i class="fas fa-circle-exclamation"></i>{{ rangeError }} — แสดงปีงบประมาณนี้แทน</span>
          @end
        </div>
      </form>

      <div class="hic-metrics">
        <div class="hic-metric hic-tone-indigo hic-rise" style="--i:0">
