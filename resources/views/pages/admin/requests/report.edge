          </div>
        </div>
      </div>

      @if(stats.total === 0)
        <div class="hic-panel">
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-chart-pie"></i></span>
            <b>ไม่มีคำขอในช่วงวันที่นี้</b>
            <span>ลองเลือกช่วงวันที่อื่น</span>
          </div>
        </div>
      @else
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
          <section class="hic-panel overflow-hidden">
            <div class="hic-panel-head"><h2><i class="fas fa-signal" style="color:var(--heading)"></i>ตามสถานะ</h2></div>
            <div class="hic-table-wrap" style="max-height:none">
              <table class="hic-table">
                <tbody>
                  @each(s in stats.byStatus)
                    <tr>
                      <td><a href="/admin/requests?status={{ s.status }}" class="hic-badge {{ s.badge }}">{{ s.label }}</a></td>
                      <td style="text-align:right" class="hic-mono">{{ s.total }}</td>
                      <td style="text-align:right;color:var(--ink-subtle)">{{ (stats.total > 0 ? Math.round((s.total / stats.total) * 100) + '%' : '—') }}</td>
                    </tr>
                  @end
                </tbody>
              </table>
            </div>
          </section>

          <section class="hic-panel overflow-hidden">
            <div class="hic-panel-head"><h2><i class="fas fa-file-export" style="color:var(--heading)"></i>รูปแบบผลลัพธ์ที่ขอ</h2></div>
            <div class="hic-table-wrap" style="max-height:none">
              <table class="hic-table">
                <tbody>
                  @each(o in stats.byOutput)
                    <tr>
                      <td>{{ o.label }}</td>
                      <td style="text-align:right" class="hic-mono">{{ o.total }}</td>
                      <td style="text-align:right;color:var(--ink-subtle)">{{ (stats.total > 0 ? Math.round((o.total / stats.total) * 100) + '%' : '—') }}</td>
                    </tr>
                  @end
                </tbody>
              </table>
            </div>
          </section>

          <section class="hic-panel overflow-hidden">
            <div class="hic-panel-head"><h2><i class="fas fa-user-lock" style="color:var(--heading)"></i>ระดับข้อมูล</h2></div>
            <div class="hic-table-wrap" style="max-height:none">
              <table class="hic-table">
                <tbody>
                  @each(l in stats.byDataLevel)
                    <tr>
                      <td>{{ l.label }}</td>
                      <td style="text-align:right" class="hic-mono">{{ l.total }}</td>
                      <td style="text-align:right;color:var(--ink-subtle)">{{ (stats.total > 0 ? Math.round((l.total / stats.total) * 100) + '%' : '—') }}</td>
                    </tr>
                  @end
                </tbody>
              </table>
            </div>
          </section>
        </div>

        @each(group in [
          { title: 'รายเดือน', icon: 'fa-calendar-days', first: 'เดือน', rows: stats.monthly.map((m) => ({ ...m, label: m.month })) },
          { title: 'ตามหน่วยงานผู้ขอ', icon: 'fa-building', first: 'หน่วยงาน', rows: stats.byDepartment },
          { title: 'ตามผู้รับผิดชอบ', icon: 'fa-user-gear', first: 'ผู้รับผิดชอบ', rows: stats.byAssignee },
        ])
          <section class="hic-panel overflow-hidden">
            <div class="hic-panel-head"><h2><i class="fas {{ group.icon }}" style="color:var(--heading)"></i>{{ group.title }}</h2></div>
            @if(group.rows.length === 0)
              <div class="hic-empty"><b>ยังไม่มีข้อมูล</b></div>
            @else
              <div class="hic-table-wrap" style="max-height:none">
                <table class="hic-table">
                  <thead>
                    <tr>
                      <th>{{ group.first }}</th>
                      <th style="text-align:right">คำขอ</th>
                      <th style="text-align:right">เสร็จสิ้น</th>
                      <th style="text-align:right">ค้างอยู่</th>
                      <th style="text-align:right">เวลาเฉลี่ย</th>
                    </tr>
                  </thead>
                  <tbody>
                    @each(row in group.rows)
                      <tr>
                        <td>{{ row.label }}</td>
                        <td style="text-align:right" class="hic-mono">{{ row.total }}</td>
                        <td style="text-align:right" class="hic-mono">{{ row.completed }}</td>
                        <td style="text-align:right" class="hic-mono">{{ row.open || '—' }}</td>
                        <td style="text-align:right;white-space:nowrap">{{ (row.avgDays === null ? '—' : row.avgDays + ' วัน') }}</td>
                      </tr>
                    @end
                  </tbody>
                </table>
              </div>
            @end
          </section>
        @end
