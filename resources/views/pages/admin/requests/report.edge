            <div class="hic-metric-value">{{ stats.completed }}</div>
            <div class="hic-help">{{ stats.completionRate === null ? 'ยังไม่มีคำขอที่ตัดสินแล้ว' : stats.completionRate + '% ของที่อนุมัติ/ไม่อนุมัติ' }}</div>
          </div>
        </div>
        <div class="hic-metric hic-tone-blue hic-rise" style="--i:2">
          <span class="hic-metric-icon"><i class="fas fa-stopwatch"></i></span>
          <div>
            <div class="hic-metric-label">เวลาเฉลี่ยส่ง → ปิดงาน</div>
            <div class="hic-metric-value">{{ (stats.avgDays === null ? '—' : stats.avgDays + ' วัน') }}</div>
            <div class="hic-help">ทันกำหนด {{ stats.onTime }}/{{ stats.dueTracked }} ({{ (stats.dueTracked > 0 ? Math.round((stats.onTime / stats.dueTracked) * 100) + '%' : '—') }})</div>
          </div>
        </div>
        <div class="hic-metric hic-tone-red hic-rise" style="--i:3">
