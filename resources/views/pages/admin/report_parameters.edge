@component('layouts/app', {
  title: 'พารามิเตอร์รายงาน · HisReport',
  showSidebar: true,
  isAdmin: true,
  fullname: auth.user.fullname || auth.user.username,
  department: auth.user.department,
  currentPage: 'report-settings',
})
  @slot('main')
    @let(typeIcons = { text: 'fa-font', number: 'fa-hashtag', date: 'fa-calendar-day', datetime: 'fa-clock', select: 'fa-list', textarea: 'fa-align-left' })
    <div class="max-w-6xl mx-auto flex flex-col gap-6">
      <div>
        <nav class="hic-crumb" aria-label="breadcrumb">
          <a href="/admin/report-settings"><i class="fas fa-sliders"></i> ตั้งค่ารายงาน</a>
          <i class="fas fa-chevron-right"></i>
          <span>พารามิเตอร์</span>
        </nav>
        <div class="hic-pagehead" style="margin-bottom:0">
          <div class="hic-pagehead-title hic-tone-yellow">
            <span class="hic-pagehead-icon"><i class="fas fa-list-check"></i></span>
            <div class="min-w-0">
              <h1>พารามิเตอร์ของรายงาน</h1>
              <p class="break-words">รายงาน: <b style="color:var(--ink-strong)">{{{ safeReportTitle(report.detail) }}}</b></p>
            </div>
          </div>
          <div class="flex gap-2 flex-wrap">
            <a href="/reports/{{ report.id }}" class="hic-btn hic-btn-secondary"><i class="fas fa-eye"></i><span>เปิดรายงาน</span></a>
            <button type="button" onclick="openParamModal()" class="hic-btn hic-btn-primary"><i class="fas fa-plus"></i><span>เพิ่มพารามิเตอร์</span></button>
          </div>
        </div>
      </div>

      @include('partials/flash')

      {{-- Detected from SQL --}}
      <section class="hic-panel hic-rise">
        <div class="hic-panel-head">
          <div>
            <h2><i class="fas fa-magnifying-glass-chart" style="color:var(--heading)"></i>พารามิเตอร์ที่ตรวจพบใน SQL</h2>
            <p>token ในรูปแบบ <code class="hic-mono">{{ '@' }}name</code> ที่พบใน SQL ของรายงานนี้</p>
          </div>
          @if(detected.length > 0)
            <span class="hic-pill">{{ detected.length }}</span>
          @end
        </div>
        <div class="hic-panel-body">
          @if(detected.length === 0)
            <p class="text-sm" style="color:var(--ink-subtle)"><i class="fas fa-circle-info mr-1"></i>ไม่พบ <code class="hic-mono">{{ '@' }}token</code> ใน SQL ของรายงานนี้</p>
          @else
            <div class="flex flex-wrap gap-2">
              @each(name in detected)
                @let(isUndef = undefinedDetected.includes(name))
                <span class="hic-badge {{ isUndef ? 'hic-badge-warn' : 'hic-badge-ok' }} hic-mono" style="font-size:12.5px;padding:4px 10px">
                  <i class="fas {{ isUndef ? 'fa-circle-exclamation' : 'fa-circle-check' }}"></i>{{ '@' + name }}
                </span>
              @end
            </div>
            @if(undefinedDetected.length > 0)
              <div class="mt-4 pt-4 flex flex-wrap gap-3 items-center justify-between" style="border-top:1px dashed var(--border-strong)">
                <div class="text-sm" style="color:var(--warn)">
                  <i class="fas fa-triangle-exclamation"></i>
                  ยังไม่ได้กำหนด {{ undefinedDetected.length }} ตัว: <span class="hic-mono">{{ undefinedDetected.map(d => '@' + d).join(', ') }}</span>
                </div>
                <form method="POST" action="/admin/reports/{{ report.id }}/parameters/auto-detect">
                  {{ csrfField() }}
                  <button type="submit" class="hic-btn hic-btn-primary hic-btn-sm">
                    <i class="fas fa-wand-magic-sparkles"></i>สร้างพารามิเตอร์อัตโนมัติ
                  </button>
                </form>
              </div>
            @end
          @end
        </div>
      </section>

      {{-- Existing params list --}}
      <section class="hic-panel overflow-hidden hic-rise" style="--i:1">
        <div class="hic-panel-head">
          <div>
            <h2><i class="fas fa-sliders" style="color:var(--heading)"></i>พารามิเตอร์ที่กำหนด <span class="hic-pill">{{ parameters.length }}</span></h2>
            <p>ฟิลด์เหล่านี้จะแสดงในฟอร์มเงื่อนไขของหน้ารายงาน ตามลำดับ</p>
          </div>
        </div>
        @if(parameters.length === 0)
          <div class="hic-empty">
            <span class="hic-empty-icon"><i class="fas fa-inbox"></i></span>
            <b>ยังไม่มีพารามิเตอร์</b>
            <span>เพิ่มเองหรือกด "สร้างพารามิเตอร์อัตโนมัติ" จาก token ที่ตรวจพบ</span>
          </div>
        @else
          <div class="overflow-x-auto">
            <table class="hic-table">
              <thead>
                <tr>
                  <th style="width:60px;text-align:center">ลำดับ</th>
                  <th>ชื่อ</th>
                  <th>คำอธิบาย</th>
                  <th>ชนิด</th>
                  <th>ค่าเริ่มต้น</th>
                  <th style="text-align:center">บังคับ</th>
                  <th style="text-align:right">จัดการ</th>
                </tr>
              </thead>
              <tbody>
                @each(p in parameters)
                  <tr>
                    <td style="text-align:center;color:var(--ink-muted)">{{ p.sortOrder }}</td>
                    <td><span class="hic-mono font-semibold" style="color:var(--brand-from)">{{ '@' + p.paramName }}</span></td>
                    <td style="color:var(--ink-strong)">{{ p.paramLabel }}</td>
                    <td><span class="hic-badge hic-badge-muted"><i class="fas {{ typeIcons[p.paramType] || 'fa-font' }}"></i>{{ p.paramType }}</span></td>
                    <td>{{ p.paramDefault || '—' }}</td>
                    <td style="text-align:center">
                      @if(p.paramRequired)
                        <span class="hic-badge hic-badge-ok"><i class="fas fa-check"></i>ใช่</span>
                      @else
                        <span style="color:var(--ink-muted)">—</span>
                      @end
                    </td>
                    <td>
                      <div class="flex justify-end gap-1">
                        <button type="button" title="แก้ไข" class="hic-act is-brand"
                          onclick="openParamModal({{ JSON.stringify({ id: p.id, param_name: p.paramName, param_label: p.paramLabel, param_type: p.paramType, param_default: p.paramDefault, param_required: p.paramRequired, options: p.options, sort_order: p.sortOrder }) }})"><i class="fas fa-pen"></i></button>
                        <button type="button" title="ลบ" class="hic-act is-bad"
                          onclick="confirmDeleteParam({{ p.id }}, {{ JSON.stringify(p.paramName) }})"><i class="fas fa-trash"></i></button>
                      </div>
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
        @end
      </section>
    </div>

    {{-- Param modal --}}
    <div id="paramModal" class="hic-modal hidden" role="dialog" aria-modal="true">
      <div class="hic-modal-box hic-tone-yellow">
        <div class="hic-modal-head">
          <span class="hic-modal-icon"><i class="fas fa-list-check"></i></span>
          <h3 id="paramModalTitle">เพิ่มพารามิเตอร์</h3>
          <button type="button" onclick="hide('paramModal')" class="hic-iconbtn" aria-label="ปิด"><i class="fas fa-xmark"></i></button>
        </div>
        <form id="paramForm" method="POST" action="/admin/reports/{{ report.id }}/parameters" class="contents">
          {{ csrfField() }}
          <input type="hidden" name="id" id="param_id" />
          <div class="hic-modal-body">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="hic-label" for="param_name">ชื่อ (param_name) <span class="hic-req">*</span></label>
                <div class="hic-field-icon">
                  <i class="fas fa-at"></i>
                  <input name="param_name" id="param_name" required pattern="[a-zA-Z_][a-zA-Z0-9_]*" class="hic-input hic-mono" style="font-size:14px" />
                </div>
                <div class="hic-help">ต้องตรงกับ <code class="hic-mono">{{ '@' }}token</code> ใน SQL</div>
              </div>
              <div>
                <label class="hic-label" for="param_label">คำอธิบาย (label) <span class="hic-req">*</span></label>
                <input name="param_label" id="param_label" required class="hic-input" placeholder="เช่น วันที่เริ่มต้น" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div>
                <label class="hic-label" for="param_type">ชนิด <span class="hic-req">*</span></label>
                <select name="param_type" id="param_type" required
                  onchange="document.getElementById('options_wrap').style.display = this.value === 'select' ? '' : 'none'"
                  class="hic-input">
                  <option value="text">text</option>
                  <option value="number">number</option>
                  <option value="date">date</option>
                  <option value="datetime">datetime</option>
                  <option value="select">select</option>
                  <option value="textarea">textarea</option>
                </select>
              </div>
              <div>
                <label class="hic-label" for="param_default">ค่าเริ่มต้น</label>
                <input name="param_default" id="param_default" class="hic-input" />
              </div>
              <div>
                <label class="hic-label" for="sort_order">ลำดับ</label>
                <input type="number" name="sort_order" id="sort_order" min="1" value="1" class="hic-input" />
              </div>
            </div>

            <div id="options_wrap" style="display:none">
              <label class="hic-label" for="options">ตัวเลือก <small>(สำหรับ select)</small></label>
              <input name="options" id="options" placeholder="comma,separated หรือ JSON array" class="hic-input" />
              <div class="hic-help">เช่น <code class="hic-mono">option1, option2, option3</code></div>
            </div>

            <label class="hic-switch">
              <input type="checkbox" name="param_required" id="param_required" value="1" />
              <span class="track"></span>
              <span>จำเป็นต้องกรอก</span>
            </label>
          </div>
          <div class="hic-modal-foot">
            <button type="button" onclick="hide('paramModal')" class="hic-btn hic-btn-ghost">ยกเลิก</button>
            <button type="submit" class="hic-btn hic-btn-primary"><i class="fas fa-floppy-disk"></i>บันทึก</button>
          </div>
        </form>
      </div>
    </div>

    <form id="deleteParamForm" method="POST" action="/admin/parameters/delete" class="hidden">
      {{ csrfField() }}
      <input type="hidden" name="id" id="deleteParamId" />
    </form>

    <script>
      function show(id) { const m = document.getElementById(id); m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden' }
      function hide(id) { const m = document.getElementById(id); m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = '' }

      function openParamModal(p) {
        const f = document.getElementById('paramForm')
        f.reset()
        if (p && p.id) {
          f.action = '/admin/parameters/update'
          document.getElementById('paramModalTitle').textContent = 'แก้ไขพารามิเตอร์'
          document.getElementById('param_id').value = p.id
          document.getElementById('param_name').value = p.param_name || ''
          document.getElementById('param_label').value = p.param_label || ''
          document.getElementById('param_type').value = p.param_type || 'text'
          document.getElementById('param_default').value = p.param_default || ''
          document.getElementById('sort_order').value = p.sort_order || 1
          document.getElementById('param_required').checked = !!p.param_required
          let optsStr = ''
          try {
            const arr = p.options ? JSON.parse(p.options) : null
            if (Array.isArray(arr)) optsStr = arr.join(', ')
            else optsStr = p.options || ''
          } catch { optsStr = p.options || '' }
          document.getElementById('options').value = optsStr
          document.getElementById('options_wrap').style.display = p.param_type === 'select' ? '' : 'none'
        } else {
          f.action = '/admin/reports/{{ report.id }}/parameters'
          document.getElementById('paramModalTitle').textContent = 'เพิ่มพารามิเตอร์'
          document.getElementById('param_id').value = ''
          document.getElementById('sort_order').value = 1
          document.getElementById('options_wrap').style.display = 'none'
        }
        show('paramModal')
      }

      function confirmDeleteParam(id, name) {
        if (!confirm('ยืนยันลบพารามิเตอร์ "' + name + '"?')) return
        document.getElementById('deleteParamId').value = id
        document.getElementById('deleteParamForm').submit()
      }
      document.getElementById('paramModal').addEventListener('click', e => { if (e.target.id === 'paramModal') hide('paramModal') })
      document.addEventListener('keydown', e => { if (e.key === 'Escape') hide('paramModal') })
    </script>
  @end
@end
